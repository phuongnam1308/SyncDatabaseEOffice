                                                                            'modes': [{
                                                                                type: 'flash',
                                                                                src: '/_layouts/15/eOfficeVideos/player.swf'
                                                                            }]
                                                                        });
                                                                    }

                                                                    function ChangeDisplay() {
                                                                        var FileWopiFrame = ['doc', 'docx', 'xls', 'xlsx', 'pdf', 'ppt', 'pptx']
                                                                        var divAll = $("a");
                                                                        if (divAll != null) {
                                                                            divAll.each(function() {
                                                                                if ($(this).prop("href").indexOf("/tintuc/Documents/") > 0) {
                                                                                    var url = $(this).prop("href");
                                                                                    var site = url.replace(url.substring(url.indexOf('/tintuc/'), url.length), '');
                                                                                    if (!detectMob())
                                                                                        url = encodeURIComponent($(this).prop("href"));
                                                                                    var FileExt = getFileExtension($(this).attr("href")).toLowerCase();
                                                                                    if (FileWopiFrame.indexOf(FileExt) >= 0)
                                                                                        $(this).attr("href", site + "/tintuc/_layouts/15/WopiFrame.aspx?sourcedoc=" + url);
                                                                                    $(this).attr("target", "_blank");
                                                                                }
                                                                            });
                                                                        }
                                                                    }
                                                                    function getFileExtension(url) {
                                                                        if (!url)
                                                                            return '';
                                                                        var parts = url.split('.');
                                                                        return parts.length > 1 ? parts.pop().split(/\#|\?/)[0] : '';
                                                                    }
                                                                    function detectMob() {
                                                                        const toMatch = [/Android/i, /webOS/i, /iPhone/i, /iPad/i, /iPod/i, /BlackBerry/i, /Windows Phone/i];

                                                                        return toMatch.some((toMatchItem)=>{
                                                                            return navigator.userAgent.match(toMatchItem);
                                                                        }
                                                                        );
                                                                    }

                                                                    $(document).ready(function() {
                                                                        ChangeDisplay();
                                                                        PlayerNowIcon();
                                                                    });
                                                                </script>
