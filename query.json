itle></m:properties></content></entry><entry><id>6d3b21f7-858a-4b55-8de1-0751dfe132b9</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Nguyễn Sơn Hải - GĐ TCIS</d:Title></m:properties></content></entry><entry><id>7f73466e-5b9d-4027-b151-db676f9f34c0</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Nguyễn Ngọc Đức - CNTT</d:Title></m:properties></content></entry><entry><id>b99b11cf-4eb9-4cb2-9c02-f8761f829a8f</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Lê Thành Tâm - TCIS</d:Title></m:properties></content></entry><entry><id>ee705ceb-c932-4c78-8645-98ea9d80b764</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Nguyễn Thanh Quang - TB CNTT</d:Title></m:properties></content></entry><entry><id>6c8141a0-f4f8-4b28-a79d-4b0c2e1d2f69</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Bùi Hải Quân - CT HĐQT DVKT</d:Title></m:properties></content></entry></feed></m:inline></link><link rel="http://schemas.microsoft.com/ado/2007/08/dataservices/related/Author" type="application/atom+xml;type=entry" title="Author" href="Web/Lists(guid'fec511d8-e617-41c0-9c63-ead5cb201f8a')/Items(1178)/Author"><m:inline><entry><id>e367206e-91de-4863-bfb7-2ff9c06ef36d</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Lê Quang Khánh - PGĐ TCIS</d:Title></m:properties></content></entry></m:inline></link><link rel="http://schemas.microsoft.com/ado/2007/08/dataservices/related/Editor" type="application/atom+xml;type=entry" title="Editor" href="Web/Lists(guid'fec511d8-e617-41c0-9c63-ead5cb201f8a')/Items(1178)/Editor"><m:inline><entry><id>99a3baaa-2a81-4803-a649-6d90391f1253</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Nguyễn Văn Tuấn - ĐP TTDDC</d:Title></m:properties></content></entry></m:inline></link><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:FileSystemObjectType m:type="Edm.Int32">0</d:FileSystemObjectType><d:Id m:type="Edm.Int32">1178</d:Id><d:ContentTypeId>0x010800D69788E4040B5E40B89CFE80B4DD7962</d:ContentTypeId><d:Title>Triển khai các hạng mục CNTT cho Cảng TCOT trước 16/03/2014</d:Title><d:Priority>Thường</d:Priority><d:PercentComplete m:type="Edm.Double">0.5</d:PercentComplete><d:AssignedToId m:type="Collection(Edm.Int32)"><d:element>970</d:element></d:AssignedToId><d:Body>&lt;div class="ExternalClass6B066F0389044838916C43758C4A13EB"&gt;&lt;p&gt;Các hạng mục cần thực hiện&amp;#58;&lt;/p&gt;&lt;p&gt;1) Phòng KH-KD TCIS&amp;#58;&lt;/p&gt;&lt;p&gt;- Lập dự toán báo giá toàn bộ kế hoạch trang bị CNTT cho TCOT. Hoàn thành trước ngày 6/3/2014.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;@Hạnh, A.Tuấn&amp;#58; Phối hợp lập dự toán các hạng mục theo yêu cầu.&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;- Đảm bảo cung cấp hàng hóa đúng tiến độ ( theo file kế hoạch​)&lt;/p&gt;&lt;p&gt;&lt;strong style="line-height&amp;#58;19.200000762939453px;"&gt;A.Tuấn&amp;#58; Thực hiện lên kế hoạch cung cấp hàng hoá từng hạng mục.&lt;/strong&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;- Báo cáo tiến độ công tác trang bị 2 ngày/ lần cho phòng CNTT.&lt;/p&gt;&lt;p&gt;2) Trung tâm SIC&amp;#58;&lt;/p&gt;&lt;p&gt;- Bố trí nhân sự giám sát và Báo cáo hàng ngày tiến độ thi công các hạng mục tại TCOT cho phòng CNTT. ( Bố trí nhân sự đảm bảo hoàn thành theo đúng KH kèm theo)&lt;br&gt;&lt;/p&gt;&lt;p&gt;- Lập bản vẽ chi tiết hệ thống mạng tại TCOT. Hoàn thành trước ngày 15/3/2014.&lt;br&gt;&lt;/p&gt;&lt;/div&gt;</d:Body><d:StartDate m:type="Edm.DateTime">2014-03-04T01: 00: 00Z</d:StartDate><d:DueDate m:type="Edm.DateTime">2014-03-16T10: 00: 00Z</d:DueDate><d:BaoCaoNhiemVu>&lt;div class="ExternalClassEBBC0A42C36E41C188C136494607698E"&gt;Đã báo giá cho Đ/c Đức phòng CNTT rà soát hạng mục thiết bị để làm dự toán&lt;/div&gt;</d:BaoCaoNhiemVu><d:DanhGiaCongViec m:type="Edm.Boolean">true</d:DanhGiaCongViec><d:DateCompleted m:null="true" /><d:DepartmentManagerId m:null="true" /><d:ItemParentID>1171</d:ItemParentID><d:NguoiPhoiHopId m:type="Collection(Edm.Int32)"><d:element>967</d:element></d:NguoiPhoiHopId><d:PriorityEN>Normal</d:PriorityEN><d:Rating m:null="true" /><d:SendMailWhenUpdate m:type="Edm.Boolean">false</d:SendMailWhenUpdate><d:StatusEN>In Progress</d:StatusEN><d:TheoDoiCongViecId m:type="Collection(Edm.Int32)"><d:element>886</d:element><d:element>970</d:element><d:element>967</d:element><d:element>740</d:element><d:element>452</d:element><d:element>453</d:element><d:element>805</d:element><d:element>427</d:element><d:element>450</d:element></d:TheoDoiCongViecId><d:TinhTrangGiaoViec>Đồng ý</d:TinhTrangGiaoViec><d:TinhTrangGiaoViecEN>Approved</d:TinhTrangGiaoViecEN><d:XacNhan m:type="Edm.Boolean">false</d:XacNhan><d:NguoiTheoDoiId m:type="Edm.Int32">886</d: