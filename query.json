/><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Hoàng Văn Anh - GĐTT TCIS</d:Title></m:properties></content></entry></m:inline></link><link rel="http://schemas.microsoft.com/ado/2007/08/dataservices/related/Editor" type="application/atom+xml;type=entry" title="Editor" href="Web/Lists(guid'fec511d8-e617-41c0-9c63-ead5cb201f8a')/Items(1393)/Editor"><m:inline><entry><id>679ba5cc-ee93-4f37-b2bf-c4909eb626e6</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Hoàng Văn Anh - GĐTT TCIS</d:Title></m:properties></content></entry></m:inline></link><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:FileSystemObjectType m:type="Edm.Int32">0</d:FileSystemObjectType><d:Id m:type="Edm.Int32">1393</d:Id><d:ContentTypeId>0x010800D69788E4040B5E40B89CFE80B4DD7962</d:ContentTypeId><d:Title>Khảo sát thiết bị CNTT thuộc TTĐĐC</d:Title><d:Priority>Thường</d:Priority><d:PercentComplete m:type="Edm.Double">1</d:PercentComplete><d:AssignedToId m:type="Collection(Edm.Int32)"><d:element>965</d:element></d:AssignedToId><d:Body>&lt;div class="ExternalClassD887732B7D7B4292AC656E4617A70003"&gt;&lt;p&gt;Dear,&lt;/p&gt;&lt;p&gt;Long phân công nhân sự khảo sát các máy cũ theo y/c&amp;#160;và báo lại kết quả&amp;#160;​&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;​&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;​(File&amp;#160;đính kèm và nd bên dưới)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;Căn cứ&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;công văn đề nghị&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;ngày&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;​08/5/2014 của TTĐĐC&amp;#160;(đính kèm), đề nghị TCIS tiến hành khảo sát các thiết bị đề xuất (PC, máy in, IP phone, VHF). Kết quả khảo sát báo&amp;#160;về P. CNTT trước ngày 21/5/2014.&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</d:Body><d:StartDate m:type="Edm.DateTime">2014-05-14T01: 00: 00Z</d:StartDate><d:DueDate m:type="Edm.DateTime">2014-05-20T10: 00: 00Z</d:DueDate><d:BaoCaoNhiemVu m:null="true" /><d:DanhGiaCongViec m:type="Edm.Boolean">true</d:DanhGiaCongViec><d:DateCompleted m:type="Edm.DateTime">2014-05-23T01: 37: 59Z</d:DateCompleted><d:DepartmentManagerId m:null="true" /><d:ItemParentID>1391</d:ItemParentID><d:NguoiPhoiHopId m:type="Collection(Edm.Int32)"><d:element>1301</d:element><d:element>886</d:element></d:NguoiPhoiHopId><d:PriorityEN>Normal</d:PriorityEN><d:Rating>5</d:Rating><d:SendMailWhenUpdate m:type="Edm.Boolean">true</d:SendMailWhenUpdate><d:StatusEN>Completed</d:StatusEN><d:TheoDoiCongViecId m:type="Collection(Edm.Int32)"><d:element>804</d:element><d:element>450</d:element><d:element>740</d:element><d:element>513</d:element><d:element>453</d:element><d:element>427</d:element><d:element>965</d:element><d:element>1301</d:element><d:element>886</d:element></d:TheoDoiCongV