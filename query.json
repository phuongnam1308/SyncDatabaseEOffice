ontent></entry></m:inline></link><link rel="http://schemas.microsoft.com/ado/2007/08/dataservices/related/Editor" type="application/atom+xml;type=entry" title="Editor" href="Web/Lists(guid'fec511d8-e617-41c0-9c63-ead5cb201f8a')/Items(1214)/Editor"><m:inline><entry><id>001a8ce2-61bf-455f-bae6-186286f525ce</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Nguyễn Văn Tuấn - ĐP TTDDC</d:Title></m:properties></content></entry></m:inline></link><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:FileSystemObjectType m:type="Edm.Int32">0</d:FileSystemObjectType><d:Id m:type="Edm.Int32">1214</d:Id><d:ContentTypeId>0x010800D69788E4040B5E40B89CFE80B4DD7962</d:ContentTypeId><d:Title>Nâng cấp thiết bị CNTT phòng huấn luyện TC</d:Title><d:Priority>Thường</d:Priority><d:PercentComplete m:type="Edm.Double">0</d:PercentComplete><d:AssignedToId m:type="Collection(Edm.Int32)"><d:element>967</d:element></d:AssignedToId><d:Body>&lt;div class="ExternalClass12D9BB5CC3ED450D99DF322D8003BDB9"&gt;&lt;p&gt;​&lt;span style="line-height&amp;#58;19.2px;"&gt;Hiện nay, hầu hết các máy tính tại phòng máy đều cũ và xuống cấp.&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.2px;"&gt;​Để phục vụ công tác chuẩn bị thi NGB&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.2px;"&gt;năm 2014 đạt kết quả tốt&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.2px;"&gt;và phục vụ cho công tác huấn luyện trong năm 2014,&amp;#160;cũng như&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.2px;"&gt;bảo đảm được chương trình huấn luyện&lt;/span&gt;&lt;span style="line-height&amp;#58;19.2px;"&gt;, Phòng Tổ chức Lao động TL đề nghị&amp;#160;khảo sát và làm kế hoạch&amp;#160;nâng cấp hệ thống máy vi tính, cũng như cài đặt lại các chương trì&lt;/span&gt;&lt;span style="line-height&amp;#58;19.2px;"&gt;nh phần mềm huấn luyện cho phù hợp với các chương trình đào tạo của TCT trong năm 2014.&amp;#160;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;@A.Tuấn&amp;#58; Anh liên hệ TT.SIC và bố trí nhân sự tổ mua bán phối hợp thực hiện&lt;/strong&gt;&lt;br&gt;&lt;span style="line-height&amp;#58;19.2px;"&gt;&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</d:Body><d:StartDate m:type="Edm.DateTime">2014-03-14T01: 00: 00Z</d:StartDate><d:DueDate m:type="Edm.DateTime">2014-04-08T10: 00: 00Z</d:DueDate><d:BaoCaoNhiemVu>&lt;div class="ExternalClass7AA23876001C461EAD11C90C5D8B6D18"&gt;Đã liên hệ TT SIC khảo sát, phòng Kinh doanh cử Đ/c bách theo dõi để phối hợp nhập thiết bị nâng cấp theo yêu cầu.&lt;/div&gt;</d:BaoCaoNhiemVu><d:DanhGiaCongViec m:type="Edm.Boolean">true</d:DanhGiaCongViec><d:DateCompleted m:null="true" /><d:DepartmentManagerId m:null="true" /><d:ItemParentID>1209</d:ItemParentID><d:NguoiPhoiHopId m:null="true" /><d:PriorityEN>Normal</d:PriorityEN><d:Rating m:null="true" /><d:SendMailWhenUpdate m:type="Edm.Boolean">true</d:SendMailWhenUpdate><d:StatusEN>Not Started</d:StatusEN><d:TheoDoiCongViecId m:type="Collection(Edm.Int32)"><d:element>804</d:element><d:element>886</d:element><d:element>740</d:element><d:element>802</d:element><d:element>427</d:element><d:element>450</d:element><d:element>967</d:element></d:TheoDoiCongViecId><d:TinhTrangGiaoViec>Đồng ý</d:TinhTrangGiaoViec><d:TinhTrangGiaoViecEN>Approved</d:TinhTrangGiaoViecEN><d:XacNhan m:type="Edm.Boolean">false</d:XacNhan><d:NguoiTheoDoiId m:type="Edm.Int32">886</d:NguoiTheoDoiId><d:ManagerId m:null="true" /><d:nStatus>Chưa bắt đầu</d:nStatus><d:ID m:type="Edm.Int32">1214</d:ID><d:MultiTask m:type="Edm.Boolean">false</d:MultiTask><d:TT m:null="true" /><d:ThucHienLai m:type="Edm.Double">0</d:ThucHienLai><d:IDVB m:null="true" /><d:ListVB m:null="true" /><d:WebVB m:null="true" /><d:NhomCongViecId m:type="Edm.Int32">10</d:NhomCongViecId