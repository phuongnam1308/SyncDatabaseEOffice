2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Ngô Quang Đường - PTP HC</d:Title></m:properties></content></entry><entry><id>96be9405-91e3-4970-97db-5060eebd9a92</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Nguyễn Văn Chiến - PTGĐ</d:Title></m:properties></content></entry></feed></m:inline></link><link rel="http://schemas.microsoft.com/ado/2007/08/dataservices/related/Author" type="application/atom+xml;type=entry" title="Author" href="Web/Lists(guid'fec511d8-e617-41c0-9c63-ead5cb201f8a')/Items(1528)/Author"><m:inline><entry><id>380f776f-9c7a-4160-9972-0f39bba09f56</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Nguyễn Văn Chiến - PTGĐ</d:Title></m:properties></content></entry></m:inline></link><link rel="http://schemas.microsoft.com/ado/2007/08/dataservices/related/Editor" type="application/atom+xml;type=entry" title="Editor" href="Web/Lists(guid'fec511d8-e617-41c0-9c63-ead5cb201f8a')/Items(1528)/Editor"><m:inline><entry><id>5ef14760-52fd-4c5a-a16a-7dc232148833</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Đậu Quốc Trấn - GĐ TTYT</d:Title></m:properties></content></entry></m:inline></link><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:FileSystemObjectType m:type="Edm.Int32">0</d:FileSystemObjectType><d:Id m:type="Edm.Int32">1528</d:Id><d:ContentTypeId>0x010800D69788E4040B5E40B89CFE80B4DD7962</d:ContentTypeId><d:Title>BÁO CÁO</d:Title><d:Priority>Thường</d:Priority><d:PercentComplete m:type="Edm.Double">1</d:PercentComplete><d:AssignedToId m:type="Collection(Edm.Int32)"><d:element>899</d:element><d:element>747</d:element><d:element>749</d:element><d:element>789</d:element></d:AssignedToId><d:Body>&lt;div class="ExternalClass6213B414B09F4CEABC70BA9DFF5E1716"&gt;&lt;p&gt;​ Để phục vụ cho công tác chuẩn bị các nội dung báo cáo văn kiện đại hội Đảng nhiệm kỳ 2015 - 2020. Vậy yêu cầu các đơn vị chuẩn bị nội dung báo cáo chuẩn bị cho ban soạn thảo văn kiện của Đảng bộ Quân cảng Sài Gòn như sau&amp;#58;&lt;/p&gt;&lt;p&gt;- Phòng Hậu cần, Văn Phòng TCT, TTYT Cảng&amp;#58; Xây dựng báo cáo đáng giá công tác triển khai nhiệm vụ trong nhiệm kỳ 2010 - 2015 với các nội dung&amp;#58; Đánh giá ưu, khuyết điểm, nguyên nhân, bài học kinh nghiệm rút ra từ thực tiễn, có số liệu so sánh cụ thể; đồng thời đề xuất phương hướng, mục tiêu, nhiệm vụ, các giải phapslanhx đạo của đơn vị mình trong nhiệm kỳ 2015 - 2020. Trước khi gửi cho ban soạn thảo yêu cầu thông qua nội dung cho đ/c PTGĐ phụ trách mảng công tác được giao.&lt;/p&gt;&lt;/div&gt;</d:Body><d:StartDate m:type="Edm.DateTime">2014-12-05T01: 00: 00Z</d:StartDate><d:DueDate m:type="Edm.DateTime">2014-12-05T10: 00: 00Z</d:DueDate><d:BaoCaoNhiemVu>&lt;div class="ExternalClassB0ED6207C8AF4F63982AF02810D77921"&gt;TTYT đang thực hiện&lt;/div&gt;</d:BaoCaoNhiemVu><d:DanhGiaCongViec m:type="Edm.Boolean">true</d:DanhGiaCongViec><d:DateCompleted m:type="Edm.DateTime">2014-12-05T03: 19: 44Z</d:DateCompleted><d:DepartmentManagerId m:null="true" /><d:ItemParentID m:null="true" /><d:NguoiPhoiHopId m:null="true" /><d:PriorityEN>Normal</d:PriorityEN><d:Rating m:null="true" /><d:SendMailWhenUpdate m:type="Edm.Boolean">false</d:SendMailWhenUpdate><d:StatusEN>Completed</d:StatusEN><d:TheoDoiCongViecId m:type="Collection(Edm.Int32)"><d:element>