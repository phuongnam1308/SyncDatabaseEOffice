ssignedToId m:type="Collection(Edm.Int32)"><d:element>970</d:element></d:AssignedToId><d:Body>&lt;div class="ExternalClass1E3B7E04737042D18879A9E5C5D30288"&gt;&lt;p&gt;​Triển khai hoàn thành các hạnh mục CNTT đảm bảo hệ thống CNTT tại Cảng TCOT&lt;/p&gt;&lt;p&gt;1. Hạng mục cơ sở hạ tầng&amp;#58; cáp quang, điện thoại, VHF ( Đức CNTT, Hạnh TCIS)&lt;/p&gt;&lt;p&gt;2. Mạng không dây ( Huy TCIS, Đức CNTT)&lt;/p&gt;&lt;p&gt;3. Phần mềm TOPS ( Hải CNTT, Tâm TCIS)&lt;/p&gt;&lt;p&gt;4. Trang bị và lằp đặt Handheld ( Thắng CNTT, Hạnh TCIS)&lt;/p&gt;&lt;p&gt;​&lt;/p&gt;&lt;/div&gt;</d:Body><d:StartDate m:type="Edm.DateTime">2014-03-04T01: 00: 00Z</d:StartDate><d:DueDate m:type="Edm.DateTime">2014-03-16T10: 00: 00Z</d:DueDate><d:BaoCaoNhiemVu m:null="true" /><d:DanhGiaCongViec m:type="Edm.Boolean">true</d:DanhGiaCongViec><d:DateCompleted m:type="Edm.DateTime">2014-03-05T04: 26: 12Z</d:DateCompleted><d:DepartmentManagerId m:null="true" /><d:ItemParentID>1166</d:ItemParentID><d:NguoiPhoiHopId m:type="Collection(Edm.Int32)"><d:element>967</d:element></d:NguoiPhoiHopId><d:PriorityEN>Normal</d:PriorityEN><d:Rating>5</d:Rating><d:SendMailWhenUpdate m:type="Edm.Boolean">false</d:SendMailWhenUpdate><d:StatusEN>Completed</d:StatusEN><d:TheoDoiCongViecId m:type="Collection(Edm.Int32)"><d:element>886</d:element><d:element>805</d:element><d:element>740</d:element><d:element>427</d:element><d:element>450</d:element><d:element>970</d:element><d:element>967</d:element></d:TheoDoiCongViecId><d:TinhTrangGiaoViec>Đồng ý</d:TinhTrangGiaoViec><d:TinhTrangGiaoViecEN>Approved</d:TinhTrangGiaoViecEN><d:XacNhan m:type="Edm.Boolean">true</d:XacNhan><d:NguoiTheoDoiId m:type="Edm.Int32">886</d:NguoiTheoDoiId><d:ManagerId m:null="true" /><d:nStatus>Hoàn thành</d:nStatus><d:ID m:type="Edm.Int32">1177</d:ID><d:MultiTask m:type="Edm.Boolean">false</d:MultiTask><d:TT m:null="true" /><d:ThucHienLai m:type="Edm.Double">0</d:ThucHienLai><d:IDVB m:null="true" /><d:ListVB m:null="true" /><d:WebVB m:null="true" /