soft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Nguyễn Thanh Quang - TB CNTT</d:Title></m:properties></content></entry><entry><id>5c4d6c80-8719-4191-87d1-f562af7a4762</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Lê Quang Khánh - PGĐ TCIS</d:Title></m:properties></content></entry><entry><id>cedc282d-d500-40fa-b2bc-80a32d6ba9b3</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Nguyễn Hoài Nam - TCIS</d:Title></m:properties></content></entry><entry><id>d512036b-0f33-49a7-8420-7ab2ce1d714a</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Nguyễn Văn Tuấn - ĐP TTDDC</d:Title></m:properties></content></entry></feed></m:inline></link><link rel="http://schemas.microsoft.com/ado/2007/08/dataservices/related/Author" type="application/atom+xml;type=entry" title="Author" href="Web/Lists(guid'fec511d8-e617-41c0-9c63-ead5cb201f8a')/Items(1438)/Author"><m:inline><entry><id>3003c35d-3c81-492f-b826-b7584e114ca0</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Lê Quang Khánh - PGĐ TCIS</d:Title></m:properties></content></entry></m:inline></link><link rel="http://schemas.microsoft.com/ado/2007/08/dataservices/related/Editor" type="application/atom+xml;type=entry" title="Editor" href="Web/Lists(guid'fec511d8-e617-41c0-9c63-ead5cb201f8a')/Items(1438)/Editor"><m:inline><entry><id>8d2574e9-4d11-4aa2-8392-8605657d94a3</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Lê Quang Khánh - PGĐ TCIS</d:Title></m:properties></content></entry></m:inline></link><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:FileSystemObjectType m:type="Edm.Int32">0</d:FileSystemObjectType><d:Id m:type="Edm.Int32">1438</d:Id><d:ContentTypeId>0x010800D69788E4040B5E40B89CFE80B4DD7962</d:ContentTypeId><d:Title>Nâng cấp thiết bị CNTT cho VP TCT</d:Title><d:Priority>Thường</d:Priority><d:PercentComplete m:type="Edm.Double">0</d:PercentComplete><d:AssignedToId m:type="Collection(Edm.Int32)"><d:element>967</d:element></d:AssignedToId><d:Body>&lt;div class="ExternalClassC4EFE40F516D4D3B9221E707E7CC2287"&gt;&lt;p&gt;Do p.CNTT không add Khánh vào ds nên anh không&amp;#160;để&amp;#160;ý vẫn gửi cho em.&lt;/p&gt;&lt;p&gt;Anh gửi lại kết quả khảo sát của&amp;#160;đ/c Thành.&lt;/p&gt;&lt;p&gt;--------------------------------------&lt;/p&gt;&lt;p&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;Căn cứ công văn&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;đề nghị của Văn phòng TCT&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;và&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;kết quả khảo sát thiết bị CNTT&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;của VP&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;do TCIS thực hiện, đề nghị TCIS&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;​tiến hành thay thế, nâng cấp&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;&amp;#160;các&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;hạng mục theo đề xuất. Các hạng mục nhỏ lẻ (1,
2,&amp;#160;5) sẽ tính vào trang bị nhỏ lẻ; các hạng mục 4,
