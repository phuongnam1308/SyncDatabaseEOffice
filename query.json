ry" title="Author" href="Web/Lists(guid'fec511d8-e617-41c0-9c63-ead5cb201f8a')/Items(1422)/Author"><m:inline><entry><id>760d3fe0-1d37-4b53-ba06-1a89dd713952</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Nguyễn Văn Hạnh - PTGĐ</d:Title></m:properties></content></entry></m:inline></link><link rel="http://schemas.microsoft.com/ado/2007/08/dataservices/related/Editor" type="application/atom+xml;type=entry" title="Editor" href="Web/Lists(guid'fec511d8-e617-41c0-9c63-ead5cb201f8a')/Items(1422)/Editor"><m:inline><entry><id>1ae9fb65-82b4-4907-9bc7-c55e8547151b</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Lê Tuấn Dũng - GĐ DVHH</d:Title></m:properties></content></entry></m:inline></link><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:FileSystemObjectType m:type="Edm.Int32">0</d:FileSystemObjectType><d:Id m:type="Edm.Int32">1422</d:Id><d:ContentTypeId>0x010800D69788E4040B5E40B89CFE80B4DD7962</d:ContentTypeId><d:Title>Một số công việc trong tuần 24, các CQ, ĐV chuẩn bị báo cáo phối hợp với VP đưa vào lịch:</d:Title><d:Priority>Thường</d:Priority><d:PercentComplete m:type="Edm.Double">1</d:PercentComplete><d:AssignedToId m:type="Collection(Edm.Int32)"><d:element>753</d:element><d:element>1153</d:element><d:element>780</d:element><d:element>746</d:element></d:AssignedToId><d:Body>&lt;div class="ExternalClass961F6AE1737F44FC80656F1FEA886123"&gt;&lt;p&gt;​&lt;/p&gt;&lt;p&gt;1- Giao ban Trung tâm an ninh &amp;#160; &amp;#160;chuận bị&amp;#58; P. QSBV&lt;/p&gt;&lt;p&gt;2- Họp nghe báo cáo nâng cấp bến phao cảng Cát lái, C bị&amp;#58; Cảng vụ, QLCT&lt;/p&gt;&lt;p&gt;3- Họp với DVHH về công tác SX, bố trí tàu lai dắt và công tác an toàn.&lt;/p&gt;&lt;p&gt;4- Họp Tổ Giám sát ATGT. đ/c Ngọc tổ trưởng chuẩn bị&lt;/p&gt;&lt;p&gt;5- Họp Ban tổ chức, Ban kỹ thuật hội thao APA&amp;#58; Đ/c Nhã chuẩn bị&lt;/p&gt;&lt;p&gt;6- VP nắm lại Cảng vụ bố trí 01 buổi ký kế hoạch phối hợp với Cục CS đường thủy&lt;/p&gt;&lt;/div&gt;</d:Body><d:StartDate m:type="Edm.DateTime">2014-06-08T01: 00: 00Z</d:StartDate><d:DueDate m:type="Edm.DateTime">2014-06-08T10: 00: 00Z</d:DueDate><d:BaoCaoNhiemVu m:null="true" /><d:DanhGiaCongViec m:type="Edm.Boolean">true</d:DanhGiaCongViec><d:DateCompleted m:type="Edm.DateTime">2014-06-13T09: 09: 11Z</d:DateCompleted><d:DepartmentManagerId m:null="true" /><d:ItemParentID m:null="true" /><d:NguoiPhoiHopId m:null="true" /><d:PriorityEN>Normal</d:PriorityEN><d:Rating m:null="true" /><d:SendMailWhenUpdate m:type="Edm.Boolean">false</d:SendMailWhenUpdate><d:StatusEN>Completed</d:StatusEN><d:TheoDoiCongViecId m:type="Collection(Edm.Int32)"><d:element>753</d:element><d:element>1153</d:element><d:element>780</d:element><d:element>746</d:element><d:element>728</d:element></d:TheoDoiCongViecId><d:TinhTrangGiaoViec>Đồng ý</d:TinhTrangGiaoViec><d:TinhTrangGiaoViecEN>Approved</d:TinhTrangGiaoViecEN><d:XacNhan m:type="Edm.Boolean">false</d:XacNhan><d:NguoiTheoDoiId m:type="Edm.Int32">728</d:NguoiTheoDoiId><d:ManagerId m:null="true" /><d:nStatus>Hoàn thành</d:nStatus><d:ID m:type="Edm.Int32">1422</d:ID><d:MultiTask m:type="Edm.Boolean">false</d:MultiTask><d:TT m:null="true" /><d:ThucHienLai m:type="Edm.Double">0</d:ThucHienLai><d:IDVB m:null="true" /><d:ListVB m:null="true" /><d:WebVB m:null="true" /><d:NhomCongViecId m:type="Edm.Int32">13</d:NhomCongViecId><d:ChatLuong m:null="true" /><d:DiemTrungBinh m:null="true" /><d:AuthorId m:type="Edm.Int32">728</d:AuthorId><d:RecurTaskParentID m:null="true" /><d:IsRecurrence m:type="Edm.Boolean">false</d:IsRecurrence><d:Recurrence m:null="true