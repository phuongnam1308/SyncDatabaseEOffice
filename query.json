:inline><entry><id>e7bbc4d9-76d8-4944-be3e-7a2760f3e19b</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Nguyễn Thanh Quang - TB CNTT</d:Title></m:properties></content></entry></m:inline></link><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:FileSystemObjectType m:type="Edm.Int32">0</d:FileSystemObjectType><d:Id m:type="Edm.Int32">1391</d:Id><d:ContentTypeId>0x010800D69788E4040B5E40B89CFE80B4DD7962</d:ContentTypeId><d:Title>Khảo sát thiết bị CNTT thuộc TTĐĐC</d:Title><d:Priority>Thường</d:Priority><d:PercentComplete m:type="Edm.Double">1</d:PercentComplete><d:AssignedToId m:type="Collection(Edm.Int32)"><d:element>804</d:element></d:AssignedToId><d:Body>&lt;div class="ExternalClassD887732B7D7B4292AC656E4617A70003"&gt;&lt;p&gt;​&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;​&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;​&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;Căn cứ&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;công văn đề nghị&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;ngày&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;​08/5/2014 của TTĐĐC&amp;#160;(đính kèm), đề nghị TCIS tiến hành khảo sát các thiết bị đề xuất (PC, máy in, IP phone, VHF). Kết quả khảo sát báo&amp;#160;về P. CNTT trước ngày 21/5/2014.&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</d:Body><d:StartDate m:type="Edm.DateTime">2014-05-14T01: 00: 00Z</d:StartDate><d:DueDate m:type="Edm.DateTime">2014-05-20T10: 00: 00Z</d:DueDate><d:BaoCaoNhiemVu>&lt;div class="ExternalClass7DDF779164D24710AF330BD27A911C8C"&gt;Đề nghị lần sau TCIS hoàn thành đúng hạn để P. CNTT tổng hợp trong tháng cho kịp trình TGĐ phê duyệt và trang bị cho các đơn vị.&lt;/div&gt;</d:BaoCaoNhiemVu><d:DanhGiaCongViec m:type="Edm.Boolean">true</d:DanhGiaCongViec><d:DateCompleted m:type="Edm.DateTime">2014-05-26T08: 29: 28Z</d:DateCompleted><d:DepartmentManagerId m:null="true" /><d:ItemParentID m:null="true" /><d:NguoiPhoiHopId m:type="Collection(Edm.Int32)"><d:element>450</d:element><d:element>740</d:element><d:element>513</d:element><d:element>453</d:element></d:NguoiPhoiHopId><d:PriorityEN>Normal</d:PriorityEN><d:Rating>3</d:Rating><d:SendMailWhenUpdate m:type="Edm.Boolean">false</d:SendMailWhenUpdate><d:StatusEN>Completed</d:StatusEN><d:TheoDoiCongViecId m:type="Collection(Edm.Int32)"><d:element>804</d:element><d:element>450</d:element><d:element>740</d:element><d:element>513</d:element><d:element>453</d:element><d:element>427</d:element></d:TheoDoiCongViecId><d:TinhTrangGiaoViec>Đồng ý</d:TinhTrangGiaoViec><d:TinhTrangGiaoViecEN>Approved</d:TinhTrangGiaoViecEN><d:XacNhan m:type="Edm.Boolean">false</d:XacNhan><d:NguoiTheoDoiId m:type="Edm.Int32">427</d:NguoiTheoDoiId><d:ManagerId m:null="true" /><d:nStatus>Hoàn thành</d:nStatus><d:ID m:type="Edm.Int32">1391</d:ID><d:MultiTask m:type="Edm.Boolean">false</d:MultiTask><d:TT m:null="true" /><d:ThucHienLai m:type="Edm.Double">1</d:ThucHienLai><d:IDVB m:null="true" /><d:ListVB m:null="true" /><d:WebVB m:null="true" /><d:NhomCongViecId m:type="Edm.Int32">8</d:NhomCongViecId><d:ChatLuong>9</d:ChatLuong><d:DiemTrungBinh m:type="Edm.Double">6</d:DiemTrungBinh><d:AuthorId m:type="Edm.Int32">427</d:AuthorId><d:RecurTaskParentID m:null="true" /><d:IsRecurrence m:type="Edm.Boolean">false</d:IsRecurrence><d:Recurrence m:null="true" /><d:OpenDate m:type="Edm.DateTime">2014-05-15T04: 23: 42Z</d:OpenDate><d:Created m:type="Edm.DateTime">2014-05-14T08: 27: 02Z</d:Created><d:Modified m:type="Edm.DateTime">2014-05-26T09: 38: 21Z</d:Modified><d:EditorId m:type="Edm.Int32">427</d:EditorId><d:OData__UIVersionString>9.0</d:O