1f8a')/Items(1499)/Author"><m:inline><entry><id>74148f83-b5d1-4bed-a796-3874c5fe3810</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Nguyễn Văn Chiến - PTGĐ</d:Title></m:properties></content></entry></m:inline></link><link rel="http://schemas.microsoft.com/ado/2007/08/dataservices/related/Editor" type="application/atom+xml;type=entry" title="Editor" href="Web/Lists(guid'fec511d8-e617-41c0-9c63-ead5cb201f8a')/Items(1499)/Editor"><m:inline><entry><id>28b703e5-00f5-4227-9ab4-15e0c4a74ac3</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Đậu Quốc Trấn - GĐ TTYT</d:Title></m:properties></content></entry></m:inline></link><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:FileSystemObjectType m:type="Edm.Int32">0</d:FileSystemObjectType><d:Id m:type="Edm.Int32">1499</d:Id><d:ContentTypeId>0x010800D69788E4040B5E40B89CFE80B4DD7962</d:ContentTypeId><d:Title>BAO CAO</d:Title><d:Priority>Thường</d:Priority><d:PercentComplete m:type="Edm.Double">0</d:PercentComplete><d:AssignedToId m:type="Collection(Edm.Int32)"><d:element>749</d:element></d:AssignedToId><d:Body>&lt;div class="ExternalClass859023B6E8AB4192A649FF7CA68E138E"&gt;&lt;p&gt;​ Theo công điện của cơ quan thường trực ủy ban dân số, gia đình và trẻ em Quân chủng đè nghị&amp;#58; Ban dân số, gia đình trẻ em các đơn vị &amp;lt; Chủ&amp;#160;nhiệm, phụ tránh quân y &amp;gt; tổng hợp danh sách các cặp gia đình hiếm muộn, kèm theo hóa đơn thanh toán viện phí và các chi phí kỳ thuật điều trị liên quan, gửi về cơ quan thường trực, ủy ban dân số, gia đình vá trẻ em Quân chủng &amp;lt; Phòng quân y/ Cục hậu cần &amp;gt; trước ngày 25/10/2014 để báo cáo TTBTL trích quỹ hỗ trợ. đ/c CNQY Tân cảng triển khai thực hiện.&lt;/p&gt;&lt;/div&gt;</d:Body><d:StartDate m:type="Edm.DateTime">2014-10-14T01: 00: 00Z</d:StartDate><d:DueDate m:type="Edm.DateTime">2014-10-14T10: 00: 00Z</d:DueDate><d:BaoCaoNhiemVu>&lt;div class="ExternalClass4424229133A64EA691D3394F13073865"&gt;TTYT chưa nhận được công điện.&lt;/div&gt;</d:BaoCaoNhiemVu><d:DanhGiaCongViec m:type="Edm.Boolean">true</d:DanhGiaCongViec><d:DateCompleted m:null="true" /><d:DepartmentManagerId m:null="true" /><d:ItemParentID m:null="true" /><d:NguoiPhoiHopId m:null="true" /><d:PriorityEN>Normal</d:PriorityEN><d:Rating m:null="true" /><d:SendMailWhenUpdate m:type="Edm.Boolean">false</d:SendMailWhenUpdate><d:StatusEN>Not Started</d:StatusEN><d:TheoDoiCongViecId m:type="Collection(Edm.Int32)"><d:element>749</d:element><d:element>732</d:element></d:TheoDoiCongViecId><d:TinhTrangGiaoViec>Chờ điều chỉnh</d:TinhTrangGiaoViec><d:TinhTrangGiaoViecEN>Pending adjustment</d:TinhTrangGiaoViecEN><d:XacNhan m:type="Edm.Boolean">true</d:XacNhan><d:NguoiTheoDoiId m:type="Edm.Int32">732</d:NguoiTheoDoiId><d:ManagerId m:null="true" /><d:nStatus>Chưa bắt đầu</d:nStatus><d:ID m:type="Edm.Int32">1499</d:ID><d:MultiTask m:type="Edm.Boolean">false</d:MultiTask><d:TT m:null="true" /><d:ThucHienLai m:type="Edm.Double">0</d:ThucHienLai><d:IDVB m:null="true" /><d:ListVB m:null="true" /><d:WebVB m:null="true" /><d:NhomCongViecId m:type="Edm.Int32">13</d:NhomCongViecId><d:ChatLuong m:null="true" /><d:DiemTrungBinh m:null="true" /><d:AuthorId m:type="Edm.Int32">732</d:AuthorId><d:RecurTaskParentID m:null="true" /><d:IsRecurrence m:type="Edm.Boolean">false</d:IsRecurrence><d:Recurrence m:null="true" /><d:OpenDate m:null="true" /><d:Created m:type="Edm.DateTime">2014-10-14T01: 24: 00Z</d:Created><d:Modified m:type="Edm.DateTime">2014-10-20T08: 48: 01Z</d:Modified><d:EditorId m:type="Edm.Int32">749</d:EditorId><d:OData__UIVers