><link rel="http://schemas.microsoft.com/ado/2007/08/dataservices/related/Editor" type="application/atom+xml;type=entry" title="Editor" href="Web/Lists(guid'fec511d8-e617-41c0-9c63-ead5cb201f8a')/Items(1555)/Editor"><m:inline><entry><id>cf945165-4920-428c-bd24-53364883dc02</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Trần Long - PTP CNTT</d:Title></m:properties></content></entry></m:inline></link><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:FileSystemObjectType m:type="Edm.Int32">0</d:FileSystemObjectType><d:Id m:type="Edm.Int32">1555</d:Id><d:ContentTypeId>0x010800D69788E4040B5E40B89CFE80B4DD7962</d:ContentTypeId><d:Title>Xây dựng quy chế phối hợp nội bộ Phòng</d:Title><d:Priority>Thường</d:Priority><d:PercentComplete m:type="Edm.Double">0.5</d:PercentComplete><d:AssignedToId m:type="Collection(Edm.Int32)"><d:element>1028</d:element><d:element>965</d:element><d:element>453</d:element></d:AssignedToId><d:Body>&lt;div class="ExternalClass31240D7362D0434D8A2EBD5D95FA1D80"&gt;&lt;p&gt;Để phối hợp hiệu quả giữa các bộ phận CNTT và đảm bảo hiệu quả triển khai các dự án, buổi trao đổi sáng nay đã thống nhất xây dựng quy chế phối hợp trong nội bộ Phòng CNTT, đề nghị các tổ trưởng phân công&amp;#160;anh em (trong eoffice để tiện theo dõi)&amp;#160;đóng góp xây dựng quy chế như sau&amp;#58;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Nội dung&amp;#58; các bước phối hợp trong thực hiện dự án như thế nào, các nội dung nào cần ủy quyền lâu dài. Đề nghị đề xuất vị trí công việc trong phối hợp và ủy quyền thay vì để tên người cụ thể. Các nội dung ủy quyền đặc biệt hoặc ngắn hạn sẽ ký giấy ủy quyền riêng. Đề xuất các hình thức thưởng phạt.&amp;#160;&lt;/li&gt;&lt;li&gt;Thời gian&amp;#58; gửi trước 07/3 để tổng hợp dự thảo.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;</d:Body><d:StartDate m:type="Edm.DateTime">2015-02-26T01: 00: 00Z</d:StartDate><d:DueDate m:type="Edm.DateTime">2015-03-06T10: 00: 00Z</d:DueDate><d:BaoCaoNhiemVu m:null="true" /><d:DanhGiaCongViec m:type="Edm.Boolean">true</d:DanhGiaCongViec><d:DateCompleted m:null="true" /><d:DepartmentManagerId m:null="true" /><d:ItemParentID m:null="true" /><d:NguoiPhoiHopId m:null="true" /><d:PriorityEN>Normal</d:PriorityEN><d:Rating m:null="true" /><d:SendMailWhenUpdate m:type="Edm.Boolean">true</d:SendMailWhenUpdate><d:StatusEN>In Progress</d:StatusEN><d:TheoDoiCongViecId m:type="Collection(Edm.Int32)"><d:element>1028</d:element><d:element>965</d:element><d:element>453</d:element><d:element>427</d:element></d:TheoDoiCongViecId><d:TinhTrangGiaoViec>Đồng ý</d:TinhTrangGiaoViec><d:TinhTrangGiaoViecEN>Approved</d:TinhTrangGiaoViecEN><d:XacNhan m:type="Edm.Boolean">false</d:XacNhan><d:NguoiTheoDoiId m:type="Edm.Int32">427</d:NguoiTheoDoiId><d:ManagerId m:null="true" /><d:nStatus>Đang thực hiện</d:nStatus><d:ID m:type="Edm.Int32">1555</d:ID><d:MultiTask m:type="Edm.Boolean">false</d:MultiTask><d:TT m:null="true" /><d:ThucHienLai m:type="Edm.Double">0</d:ThucHienLai><d:IDVB m:null="true" /><d:ListVB m:null="true" /><d:WebVB m:null="true" /><d:NhomCongViecId m:type="Edm.Int32">13</d:NhomCongViecId><d:ChatLuong m:null="true" /><d:DiemTrungBinh m:null="true" /><d:AuthorId m:type="Edm.Int32">427</d:AuthorId><d:RecurTaskParentID m:null="true" /><d:IsRecurrence m:type="Edm.Boolean">false</d:IsRecurrence><d:Recurrence m:null="true" /><d:OpenDate m:type="Edm.DateTime">2015-03-10T02: 28: 41Z</d:OpenDate><d:Created m:type="Edm.DateTime">2015-02-26T10: 16: 57Z</d:Created><d:Modified m:type="Edm.DateTime">2015-03-10T02: 28: 41Z</d:Modified><d:EditorId m:type="Edm.Int32">1028</d:EditorId><d:OData__UIVersionString>3.0</d:OData__UIVersionString><d:Attachments m:type="Edm.Boolean">false</d:Attachments><d:GUID m:type="Edm.Guid">40517e5f-04a3-4fd5-9ab0-0c55f441c856<