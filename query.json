.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Nguyễn Hoài Nam - TCIS</d:Title></m:properties></content></entry><entry><id>ec01574d-dc63-4596-b896-06cf4179d8e2</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Lê Quang Khánh - PGĐ TCIS</d:Title></m:properties></content></entry></feed></m:inline></link><link rel="http://schemas.microsoft.com/ado/2007/08/dataservices/related/Author" type="application/atom+xml;type=entry" title="Author" href="Web/Lists(guid'fec511d8-e617-41c0-9c63-ead5cb201f8a')/Items(1444)/Author"><m:inline><entry><id>95e23bf5-a441-4926-a19c-6f033b967cb1</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Hoàng Văn Anh - GĐTT TCIS</d:Title></m:properties></content></entry></m:inline></link><link rel="http://schemas.microsoft.com/ado/2007/08/dataservices/related/Editor" type="application/atom+xml;type=entry" title="Editor" href="Web/Lists(guid'fec511d8-e617-41c0-9c63-ead5cb201f8a')/Items(1444)/Editor"><m:inline><entry><id>d09882f2-267e-4626-9de7-29cafa0f3d3f</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Nguyễn Hoài Nam - TCIS</d:Title></m:properties></content></entry></m:inline></link><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:FileSystemObjectType m:type="Edm.Int32">0</d:FileSystemObjectType><d:Id m:type="Edm.Int32">1444</d:Id><d:ContentTypeId>0x010800D69788E4040B5E40B89CFE80B4DD7962</d:ContentTypeId><d:Title>Khảo sát, đánh giá tình trạng thiết bị của QLCT</d:Title><d:Priority>Thường</d:Priority><d:PercentComplete m:type="Edm.Double">1</d:PercentComplete><d:AssignedToId m:type="Collection(Edm.Int32)"><d:element>1301</d:element><d:element>886</d:element></d:AssignedToId><d:Body>&lt;div class="ExternalClassFEA7447BA909449E95A39FF60F661BB3"&gt;&lt;p&gt;@Nam phân công nhân sự khảo sát đ/n này nhé. Cập nhật lại kq khảo sát và đ/n CNTT confirm.&lt;/p&gt;&lt;p&gt;@Khánh&amp;#58; em xử lý tiếp sau khi có confirm của CNTT nhé.&lt;/p&gt;&lt;p&gt;----------------​&lt;span style="line-height&amp;#58;17.454545974731445px;"&gt;​&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style="line-height&amp;#58;17.454545974731445px;"&gt;Căn cứ công văn ngày 24/6 của QLCT v/v đề nghị kiểm tra,&amp;#160;thay thế thiết bị CNTT, đề nghị TCIS tiến hành khảo sát, đánh giá tình trạng thiết bị và gửi kết quả về CNTT trước ngày 03/7/2014 để tổng hợp. Việt Anh tiếp nhận kết quả khảo sát để tổng hợp lên KH trang bị trong T7/2014.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style="line-height&amp;#58;17.454545974731445px;"&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</d:Body><d:StartDate m:type="Edm.DateTime">2014-06-27T01: 00: 00Z</d:StartDate><d:DueDate m:type="Edm.DateTime">2014-07-02T10: 00: 00Z</d:DueDate><d:BaoCaoNhiemVu>&lt;div class="ExternalClass03A125C5C0C2485381E7E6BACFF06EE5"&gt;@ Việt Anh&amp;#58; SIC báo cáo kết quả khảo sát tình trạng thiết bị CNTT (như file đính kèm)
&lt;/br&gt;@Khánh&amp;#58; em xử lý tiếp sau khi có confirm của CNTT nhé&lt;/div&gt;</d:BaoCaoNhiemVu><d:DanhGiaCongViec m:type="Edm.Boolean">false</d:DanhGiaCongViec><d:DateCompleted m:type="Edm.DateTime">2014-07-04T03: 03: 37Z</d:DateCompleted><d:DepartmentManagerId m:null="true" /><d:ItemParentID>1442</d:ItemParentID><d:NguoiPhoiHopId m:null="true" /><d:PriorityEN>Normal</d:PriorityEN><d:Rating m:null="true" /><d:SendMailWhenUpdate m:type="Edm.Boolean">true</d:SendMailWhenUpdate><d:StatusEN>Completed</d:StatusEN><d:TheoDoiCongViecId m:type="Collection(Edm.Int32)"><d:element>804</d:element><d:element>450</d:element><d:element>740</d:element><d:element>1367</d:element><d:element>832</d:element><d:element>618</d:element><d:element>427</d:element><d:element>1301</d:element><d:element>886</d:element></d:TheoDoiCongViecId><d:TinhTrangGiaoViec>Đồng ý</d:TinhTrangGiaoViec><d:TinhTrangGiaoViecEN>Approved</d:TinhTrangGiaoViecEN><d:XacNhan m:type="Edm.Boolean">false</d:XacNhan><d:NguoiTheoDoiId m:type="Edm.Int32">804</d:NguoiTheoDoiId><d:ManagerId m:null="true" /><d:nStatus>Hoàn thành</d:nStatus><d:ID m:type="Edm.Int32">1444</d:ID><d:MultiTask m:type="Edm.Boolean">false</d:MultiTask><d:TT m:null="true" /><d:ThucHienLai m:type="Edm.Double">0</d:ThucHienLai><d:IDVB m:null="true" /><d:ListVB m:null="true" /><d:WebVB m:null="true" /><d:NhomCongViecId m:type="Edm.Int32">10</d:NhomCongViecId><d:ChatLuong m:null="true" /><d:DiemTrungBinh m:null="true" /><d:AuthorId m:type="Edm.Int32">804</d:AuthorId><d:RecurTaskParentID m:null="true" /><d:IsRecurrence m:type="Edm.Boolean">false</d:IsRecurrence><d:Recurrence m:null="true" /><d:OpenDate m:null="true" /><d:Created m:type="Edm.DateTime">2014-06-30T01: 19: 46Z</d:Created><d:Modified m:type="Edm.DateTime">2014-07-04T03: 03: 37Z</d:Modified><d:EditorId m:type="Edm.Int32">1301</d:EditorId><d:OData__UIVersionString>2.0</d:OData__UIVersionString><d:Attachments m:type="Edm.Boolean">false</d:Attachments><d:GUID m:type="Edm.Guid">056cd36e-9aa2