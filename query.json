2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Bùi Hải Quân - CT HĐQT DVKT</d:Title></m:properties></content></entry></feed></m:inline></link><link rel="http://schemas.microsoft.com/ado/2007/08/dataservices/related/Author" type="application/atom+xml;type=entry" title="Author" href="Web/Lists(guid'fec511d8-e617-41c0-9c63-ead5cb201f8a')/Items(1208)/Author"><m:inline><entry><id>2415b0df-97c8-4f5f-bff1-1cdeb755aaf0</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Nguyễn Thanh Quang - TB CNTT</d:Title></m:properties></content></entry></m:inline></link><link rel="http://schemas.microsoft.com/ado/2007/08/dataservices/related/Editor" type="application/atom+xml;type=entry" title="Editor" href="Web/Lists(guid'fec511d8-e617-41c0-9c63-ead5cb201f8a')/Items(1208)/Editor"><m:inline><entry><id>7a182b18-ad1f-4e90-9513-099a4c6f7017</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Nguyễn Thanh Quang - TB CNTT</d:Title></m:properties></content></entry></m:inline></link><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:FileSystemObjectType m:type="Edm.Int32">0</d:FileSystemObjectType><d:Id m:type="Edm.Int32">1208</d:Id><d:ContentTypeId>0x010800D69788E4040B5E40B89CFE80B4DD7962</d:ContentTypeId><d:Title>Nâng cấp thiết bị CNTT phòng huấn luyện TC</d:Title><d:Priority>Thường</d:Priority><d:PercentComplete m:type="Edm.Double">1</d:PercentComplete><d:AssignedToId m:type="Collection(Edm.Int32)"><d:element>427</d:element></d:AssignedToId><d:Body>&lt;div class="ExternalClass12D9BB5CC3ED450D99DF322D8003BDB9"&gt;&lt;p&gt;​&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;Hiện nay, hầu hết các máy tính tại phòng máy đều cũ và xuống cấp.&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;​Để phục vụ công tác chuẩn bị thi NGB&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;năm 2014 đạt kết quả tốt&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;và phục vụ cho công tác huấn luyện trong năm 2014. cũng như&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;bảo đảm được chương trình huấn luyện&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;, Phòng Tổ chức Lao động TL đề nghị&amp;#160;khảo sát và làm kế hoạch&amp;#160;nâng cấp hệ thống máy vi tính, cũng như cài đặt lại các chương trì&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;nh phần mềm huấn luyện cho phù hợp với các chương trình đào tạo của TCT trong năm 2014.&amp;#160;&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</d:Body><d:StartDate m:type="Edm.DateTime">2014-03-14T01: 00: 00Z</d:StartDate><d:DueDate m:type="Edm.DateTime">2014-04-08T10: 00: 00Z</d:DueDate><d:BaoCaoNhiemVu>&lt;div class="ExternalClass39B943F6E52146E7A7AB7D63B90F0D49"&gt;Đóng công việc do đã quá hạn chót từ lâu nhưng không thấy TCIS cập nhật tiến độ hoàn thành!&lt;/div&gt;</d:BaoCaoNhiemVu><d:DanhGiaCongViec m:type="Edm.Boolean">true</d:DanhGiaCongViec><d:DateCompleted m:type="Edm.DateTime">2014-05-13T02: 14: 09Z</d:DateCompleted><d:DepartmentManagerId m:null="true" /><d:ItemParentID m:null="true" /><d:NguoiPhoiHopId m:type="Collection(Edm.Int32)"><d:element>802</d:element></d:NguoiPhoiHopId><d:PriorityEN>Normal</d:PriorityEN><d:Rating m:null="true" /><d:SendMailWhenUpdate m:type="Edm.Boolean">false</d:SendMailWhenUpdate><d:StatusEN>Completed</d:StatusEN><d:TheoDoiCongViecId m:type="Collection(Ed