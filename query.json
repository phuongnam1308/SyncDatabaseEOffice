content></entry><entry><id>182ea3ee-f3b6-4aa9-9183-ecc0924d8a61</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Lê Thành Tâm - TCIS</d:Title></m:properties></content></entry><entry><id>bc30fb57-201d-4ccd-b946-7daff8817706</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Châu Hải Thương - CT HĐQT TCIS</d:Title></m:properties></content></entry><entry><id>553b16d8-795d-4469-8615-4c659476001c</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Nguyễn Thanh Quang - TB CNTT</d:Title></m:properties></content></entry><entry><id>55b2673d-ac0c-434f-8d49-544f635f83a2</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Bùi Hải Quân - CT HĐQT DVKT</d:Title></m:properties></content></entry></feed></m:inline></link><link rel="http://schemas.microsoft.com/ado/2007/08/dataservices/related/Author" type="application/atom+xml;type=entry" title="Author" href="Web/Lists(guid'fec511d8-e617-41c0-9c63-ead5cb201f8a')/Items(1199)/Author"><m:inline><entry><id>70496a2f-bcc9-4013-a3a7-5ed09b98ac9d</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Nguyễn Sơn Hải - GĐ TCIS</d:Title></m:properties></content></entry></m:inline></link><link rel="http://schemas.microsoft.com/ado/2007/08/dataservices/related/Editor" type="application/atom+xml;type=entry" title="Editor" href="Web/Lists(guid'fec511d8-e617-41c0-9c63-ead5cb201f8a')/Items(1199)/Editor"><m:inline><entry><id>e8c963e7-580c-4102-b9f4-6290c006cf37</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Lê Thành Tâm - TCIS</d:Title></m:properties></content></entry></m:inline></link><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:FileSystemObjectType m:type="Edm.Int32">0</d:FileSystemObjectType><d:Id m:type="Edm.Int32">1199</d:Id><d:ContentTypeId>0x010800D69788E4040B5E40B89CFE80B4DD7962</d:ContentTypeId><d:Title>Triển khai phần mềm TOPX+TOPO của TCCT cho TCOT</d:Title><d:Priority>Thường</d:Priority><d:PercentComplete m:type="Edm.Double">1</d:PercentComplete><d:AssignedToId m:type="Collection(Edm.Int32)"><d:element>805</d:element></d:AssignedToId><d:Body>&lt;div class="ExternalClass68CA4B9213E143879F3DA9E1665CEF70"&gt;&lt;p&gt;1/ Thiết bị xếp dỡ (a Duẩn TCOT báo có&amp;#58; 4 cẩu QC,
15 RTG ; system của TCCT đã cấp số Q01-&amp;gt;Q04, G01 -&amp;gt; G10)&amp;#58;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Gán số hiệu&amp;#58; QC là từ Q11 -&amp;gt; Q14; RTG là G11 -&amp;gt; G17 (trước mắt chỉ dùng 7/15 RTG) . Những thiết bị khác xe nâng, đầu kéo của TCCT đã có sẵn trong system. Tâm cấp trong system (sau khi Hải TCCT xác nhận) ; lưu ý&amp;#58; làm việc với nhóm mạng về phân vùng IP.&lt;/li&gt;&lt;li&gt;Dán nhãn trên thiết bị&amp;#58; Hải TCCT làm việc với TCOT để dán nhãn. Nếu OK thì báo ngay cho Tâm cập nhật system.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;2/ Tàu ( dự kiến tàu của MOL) &lt;/p&gt;&lt;ul&gt;&lt;li&gt;Lấy các thông tin tàu, service … từ TCIT, cập nhật trước vào system đễ test &amp;amp; chạy thử. Hải TCCT thực hiện.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;3/ Map cho bãi, cầu tàu&amp;#58; thống nhất dùng phần bãi, cầu tàu của TCIT để dễ phân biệt sau này. Vì RBS chỉ cho dùng từ B02-&amp;gt;B10 trong TOPX nên có chút khác biệt so với thực tế. Cụ thể sẽ làm như sau&amp;#58;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Block B02 -&amp;gt; B07&amp;#58; system và thực tế giống nhau; block B01 (sát cầu tàu và CMIT) sẽ không sử dụng.&lt;/li&gt;&lt;li&gt;Block B10 (cont lạnh)&amp;#58; system là B10, thực tế là B11 ; ko ảnh hưởng nhiều tới sản xuất.&lt;/li&gt;&lt;li&gt;Cầu tàu&amp;#58; thống nhất dùng mã B02.&lt;/li&gt;&lt;li&gt;Về system thì ko cần làm gì thêm; Hải TCCT làm việc với TCOT về đánh số các Block , rà soát và khóa lại các cell ko dùng nếu cần (tùy theo cách dùng TOPX của control).&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;4/ EDI, report&amp;#58; &lt;/p&gt;&lt;ul&gt;&lt;li&gt;Cơ bản&amp;#58; nếu là tàu của MOL thì các chế độ gửi EDI, report tương tự như TCIT. &lt;/li&gt;&lt;li&gt;Cài đặt&amp;#58; giao cho đc Tuấn SSC-TCIS (đc Năng hỗ trợ) phối hợp với đc Trung QLTH- TCCT thực hiện chi tiết.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;5/ Chạy thử&amp;#58; vì TCCT hiện nay làm hàng rất ít và việc dựng lại hệ thống test riêng rất lâu nên sẽ chạy thử trên live system luôn, test xong sẽ xóa số liệu &amp;amp; ko gửi EDI, report.&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Test lần 1 – cơ bản phần mềm&amp;#58; đổ data list nhập, TOPX&amp;#58; kiểm tra xếp cont trên tàu, move vài cont tàu – tàu, tàu bãi -&amp;gt; Ktra data TOPO. Test xong cleanup data. &lt;/li&gt;&lt;ul&gt;&lt;li&gt;Thời gian&amp;#58; dự kiến thư 6 14/03.&lt;/li&gt;&lt;li&gt;Thực hiện&amp;#58; Hải TCCT &amp;amp; Tâm TCIS chủ động thực hiện.&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Test lần 2 – toàn bộ system&amp;#58; giống như lần 1 và tất cả những tính năng điều hành của TOPX, VD&amp;#58; plan, WQ, WI … trên cả PC, Handheld, tốc độ đường truyền. &lt;/li&gt;&lt;ul&gt;&lt;li&gt;Thời gian&amp;#58; dự kiến thư 2 17/03.&lt;/li&gt;&lt;li&gt;Thực hiện&amp;#58; CNTT, TCIS, TCCT.&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;</d:Body><d:StartDate m:type="Edm.DateTime">2014-03-04T01: 00: 00Z</d:StartDate><d:DueDate m:type="Edm.DateTime">2014-03-17T10: 00: 00Z</d:DueDate><d:BaoCaoNhiemVu m:null="true" /><d:DanhGiaCongViec m:type="Edm.Boolean">false</d:DanhGiaCongViec><d:DateCompleted m:type="Edm.DateTime">2014-04-07T07: 51: 11Z</d:DateCompleted><d:DepartmentManagerId m:null="true" /><d:ItemParentID>1164</d:ItemParentID><d:NguoiPhoiHopId m:null="true" /><d:PriorityEN>Normal</d:PriorityEN><d:Rating m:null="true" /><d:SendMailWhenUpdate m:type="Edm.Boolean">false</d:SendMailWhenUpdate><d:StatusEN>Completed</d:StatusEN><d:TheoDoiCongViecId m:type="Collection(Edm.Int32)"><d:element>452</d:element><d:element>805</d:element><d:element>740</d:element><d:element>427</d:element><d:element>450</d:element></d:TheoDoiCongViecId><d:TinhTrangGiaoViec>Đồng ý</d:TinhTrangGiaoViec><d:TinhTrangGiaoViecEN>Approved</d:TinhTrangGiaoViecEN><d:XacNhan m:type="Edm.Boolean">true</d:XacNhan><d:NguoiTheoDoiId m:type="Edm.Int32">452</d:NguoiTheoDoiId><d:ManagerId m:null="true" /><d:nStatus>Hoàn thành</d:nStatus><d:ID m:type="Edm.Int32">1199</d:ID><d:MultiTask m:type="Edm.Boolean">false</d:MultiTask><d:TT m:null="true" /><d:ThucHienLai m:type="Edm.Double">0</d:ThucHienLai><d