ontent></entry><entry><id>d302d168-6e3a-4bfe-98ec-aa9f9bd140d5</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Lê Quang Khánh - PGĐ TCIS</d:Title></m:properties></content></entry><entry><id>f6bf36bc-d5e1-40a7-9776-7cddb6faa259</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Hồ Văn Quốc - P.TTAN TM</d:Title></m:properties></content></entry><entry><id>5530a58f-4fa0-4f9a-bc6f-e5524c64e280</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Nguyễn Thanh Quang - TB CNTT</d:Title></m:properties></content></entry><entry><id>f4db92f6-f159-4e9f-b026-75dfc7c98e5b</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Mai Thành Long - PB CNTT</d:Title></m:properties></content></entry></feed></m:inline></link><link rel="http://schemas.microsoft.com/ado/2007/08/dataservices/related/Author" type="application/atom+xml;type=entry" title="Author" href="Web/Lists(guid'fec511d8-e617-41c0-9c63-ead5cb201f8a')/Items(1229)/Author"><m:inline><entry><id>05823397-3307-4360-b56d-7a8e79653eab</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Hoàng Văn Anh - GĐTT TCIS</d:Title></m:properties></content></entry></m:inline></link><link rel="http://schemas.microsoft.com/ado/2007/08/dataservices/related/Editor" type="application/atom+xml;type=entry" title="Editor" href="Web/Lists(guid'fec511d8-e617-41c0-9c63-ead5cb201f8a')/Items(1229)/Editor"><m:inline><entry><id>318d2f03-1b30-436a-a9e3-7948af125953</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Hoàng Văn Anh - GĐTT TCIS</d:Title></m:properties></content></entry></m:inline></link><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:FileSystemObjectType m:type="Edm.Int32">0</d:FileSystemObjectType><d:Id m:type="Edm.Int32">1229</d:Id><d:ContentTypeId>0x010800D69788E4040B5E40B89CFE80B4DD7962</d:ContentTypeId><d:Title>Khảo sát đề nghị trang bị của QSBV T3.2014</d:Title><d:Priority>Thường</d:Priority><d:PercentComplete m:type="Edm.Double">1</d:PercentComplete><d:AssignedToId m:type="Collection(Edm.Int32)"><d:element>965</d:element></d:AssignedToId><d:Body>&lt;div class="ExternalClassA29D2F92163E4BA8A015167CCB366E9F"&gt;&lt;p&gt;Mr.Quang sent&amp;#58;&lt;/p&gt;&lt;p&gt;------------------------------------------------------&lt;/p&gt;&lt;p&gt;Căn cứ đề nghị ngày 16/3/2014 của P. QSBV (đính kèm), đề nghị TCIS khảo sát&amp;#160;yêu&amp;#160;cầu thay thế máy tính của Đội kiểm soát khu hàng văn phòng đặt tại bãi đóng rút cảng Cát Lái&amp;#58;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;span style="line-height&amp;#58;1.6;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;1.6;"&gt;Đánh giá tình trạng máy&lt;/span&gt;&lt;span style="line-height&amp;#58;1.6;"&gt;, cấu hình,&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;1.6;"&gt;năm trang bị...&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style="line-height&amp;#58;1.6;"&gt;&amp;#160;Xác định nhu cầu công việc và đề xuất cấu hình máy mới (nếu đề nghị thay thế), xác định nhu cầu kết nối mạng, phần mềm...&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style="line-height&amp;#58;1.6;"&gt;&amp;#160;Thông báo kết quả về P. CNTT trước ngày 22/3/2014.&amp;#160;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;span style="line-height&amp;#58;1.6;"&gt;Chi tiết vui lòng liên lạc anh Hồ Văn Quốc 0989004324.&lt;/span&gt;&lt;/p&gt;&lt;div&gt;---------------------------------------------------------&lt;/div&gt;&lt;div&gt;&lt;strong&gt;Mtlong&amp;#58; Em phân công nhân sự khảo sát theo nội dung yêu cầu của KH (bên trên). Phối hợp và báo lại kq cho p.CNTT (Cc&amp;#58; cho p.KHKD-TCIS qua mr.Tuấn, mr.Khánh)&lt;/strong&gt;&lt;/div&gt;&lt;p&gt;&lt;span style="line-height&amp;#58;1.6;"&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style="line-height&amp;#58;1.6;"&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style="line-height&amp;#58;1.6;"&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style="line-height&amp;#58;1.6;"&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style="line-height&amp;#58;1.6;"&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style="line-height&amp;#58;1.6;"&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</d:Body><d:StartDate m:type="Edm.DateTime">2014-03-17T01: 00: 00Z</d:StartDate><d:DueDate m:type="Edm.DateTime">2014-03-21T10: 00: 00Z</d:DueDate><d:BaoCaoNhiemVu m:null="true" /><d:DanhGiaCongViec m:type="Edm.Boolean">true</d:DanhGiaCongViec><d:DateCompleted m:type="Edm.DateTime">2014-03-21T03: 53: 13Z</d:DateCompleted><d:DepartmentManagerId m:null="true" /><d:ItemParentID>1224</d:ItemParentID><d:NguoiPhoiHopId m:null="true" /><d:PriorityEN>Normal</d:PriorityEN><d:Rating>5</d:Rating><d:SendMailWhenUpdate m:type="Edm.Boolean">true</d:SendMailWhenUpdate><d:StatusEN>Completed</d:StatusEN><d:TheoDoiCongViecId m:type="Collection(Edm.Int32)"><d:element>804</d:element><d:element>740</d:eleme