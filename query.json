properties></content></entry><entry><id>d4dc51a7-5a9c-477e-8217-cfe5f3db9e6d</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Hà Việt Anh - CNTT</d:Title></m:properties></content></entry></feed></m:inline></link><link rel="http://schemas.microsoft.com/ado/2007/08/dataservices/related/Author" type="application/atom+xml;type=entry" title="Author" href="Web/Lists(guid'fec511d8-e617-41c0-9c63-ead5cb201f8a')/Items(1488)/Author"><m:inline><entry><id>0c43e9f5-ddce-45c8-8d22-dfcb9276c636</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Hà Việt Anh - CNTT</d:Title></m:properties></content></entry></m:inline></link><link rel="http://schemas.microsoft.com/ado/2007/08/dataservices/related/Editor" type="application/atom+xml;type=entry" title="Editor" href="Web/Lists(guid'fec511d8-e617-41c0-9c63-ead5cb201f8a')/Items(1488)/Editor"><m:inline><entry><id>6e65d89d-0c46-42c7-946a-266c0bbb8f49</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Lê Quang Khánh - PGĐ TCIS</d:Title></m:properties></content></entry></m:inline></link><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:FileSystemObjectType m:type="Edm.Int32">0</d:FileSystemObjectType><d:Id m:type="Edm.Int32">1488</d:Id><d:ContentTypeId>0x010800D69788E4040B5E40B89CFE80B4DD7962</d:ContentTypeId><d:Title>Trang bị máy in màu mới cho Văn Phòng Tổng Công Ty</d:Title><d:Priority>Thường</d:Priority><d:PercentComplete m:type="Edm.Double">0</d:PercentComplete><d:AssignedToId m:type="Collection(Edm.Int32)"><d:element>1046</d:element></d:AssignedToId><d:Body>&lt;div class="ExternalClassBC94D76A06264852B2FA08A9C83C3913"&gt;&lt;p&gt;​Máy in màu của VP TCT hiện bị hư hỏng (bên đó đã báo người sửa chữa nhưng ko xử lý được). Do VP cần sử dụng in biển tên và nhiều chức ăng khác nên đề nghi TCIS cung cấp máy in màu mới có chức năng tương tự Hp 1600 để trang bị cho VP, em sẽ đưa việc này vào gói đề nghị trang bị cntt tháng 10.&lt;/p&gt;&lt;/div&gt;</d:Body><d:StartDate m:type="Edm.DateTime">2014-10-02T01: 00: 00Z</d:StartDate><d:DueDate m:type="Edm.DateTime">2014-10-03T10: 00: 00Z</d:DueDate><d:BaoCaoNhiemVu>&lt;div class="ExternalClass3DDCF06B136F468B9E61662AED9FA5B5"&gt;P.KD đang nhận báo giá và chủng loại máy in báo VP Tcty. Dự kiến tuần sau sẽ bàn giao.&lt;/div&gt;</d:BaoCaoNhiemVu><d:DanhGiaCongViec m:type="Edm.Boolean">true</d:DanhGiaCongViec><d:DateCompleted m:null="true" /><d:DepartmentManagerId m:null="true" /><d:ItemParentID m:null="true" /><d:NguoiPhoiHopId m:type="Collection(Edm.Int32)"><d:element>450</d:element><d:element>452</d:element><d:element>740</d:element><d:element>886</d:element><d:element>427</d:element><d:element>440</d:element></d:NguoiPhoiHopId><d:PriorityEN>Normal</d:PriorityEN><d:Rating m:null="true" /><d:SendMailWhenUpdate m:type="Edm.Boolean">true</d:SendMailWhenUpdate><d:StatusEN>Not Started</d:StatusEN><d:TheoDoiCongViecId m:type="Collection(Edm.Int32)"><d:element>1046</d:element><d:element>450</d:element><d:element>452</d:element><d:element>740</d:element><d:element>886</d:element><d:element>427</d:element><d:element>440</d:element><d:element>1367</d:element></d:TheoDoiCongViecId><d:TinhTrangGiaoViec>Đồng ý</d:TinhTrangGiaoViec><d:TinhTrangGiaoViecEN>Approved</d:TinhTrangGiaoViecEN><d:XacNhan m:type="Edm.Boolean">false</d:XacNhan><d:NguoiTheoDoiId m:type="Edm.Int32">1367</d:NguoiTheoDoiId><d:ManagerId m:null="true" /><d:nStatus>Chưa