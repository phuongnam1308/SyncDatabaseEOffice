ry term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>2 - BCH VP</d:Title></m:properties></content></entry><entry><id>dca73eca-d89a-4908-8bed-ac63a0241463</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Nguyễn Văn Hạnh - PTGĐ</d:Title></m:properties></content></entry></feed></m:inline></link><link rel="http://schemas.microsoft.com/ado/2007/08/dataservices/related/Author" type="application/atom+xml;type=entry" title="Author" href="Web/Lists(guid'fec511d8-e617-41c0-9c63-ead5cb201f8a')/Items(1421)/Author"><m:inline><entry><id>1a78ef0c-e11f-4e54-b554-59d5ea3b08b2</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Nguyễn Văn Hạnh - PTGĐ</d:Title></m:properties></content></entry></m:inline></link><link rel="http://schemas.microsoft.com/ado/2007/08/dataservices/related/Editor" type="application/atom+xml;type=entry" title="Editor" href="Web/Lists(guid'fec511d8-e617-41c0-9c63-ead5cb201f8a')/Items(1421)/Editor"><m:inline><entry><id>e354b0bb-7b5b-455f-8f5d-22d1a437faf3</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Nguyễn Văn Phương - CN CTr</d:Title></m:properties></content></entry></m:inline></link><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:FileSystemObjectType m:type="Edm.Int32">0</d:FileSystemObjectType><d:Id m:type="Edm.Int32">1421</d:Id><d:ContentTypeId>0x010800D69788E4040B5E40B89CFE80B4DD7962</d:ContentTypeId><d:Title>Một số công việc trong tuần 24 của Hạnh:</d:Title><d:Priority>Thường</d:Priority><d:PercentComplete m:type="Edm.Double">1</d:PercentComplete><d:AssignedToId m:type="Collection(Edm.Int32)"><d:element>898</d:element></d:AssignedToId><d:Body>&lt;div class="ExternalClass53EFB9D489014F358C4444D1EBDA1B39"&gt;&lt;p&gt;​VP đưa vào lịch một số công việc trong tuần tới&amp;#58;&lt;/p&gt;&lt;p&gt;1- Giao ban Trung tâm an ninh &amp;#160; &amp;#160;chuận bị&amp;#58; P. QSBV&lt;/p&gt;&lt;p&gt;2- Họp nghe báo cáo nâng cấp bến phao cảng Cát lái, C bị&amp;#58; Cảng vụ, QLCT&lt;/p&gt;&lt;p&gt;3- Họp với DVHH về công tác SX, bố trí tàu lai dắt và công tác an toàn.&lt;/p&gt;&lt;p&gt;4- Họp Tổ Giám sát ATGT. đ/c Ngọc tổ trưởng chuẩn bị&lt;/p&gt;&lt;p&gt;5- Họp Ban tổ chức, Ban kỹ thuật hội thao APA&amp;#58; Đ/c Nhã chuẩn bị&lt;/p&gt;&lt;p&gt;6- VP nắm lại Cảng vụ bố trí 01 buổi ký kế hoạch phối hợp với Cục CS đường thủy&lt;/p&gt;&lt;/div&gt;</d:Body><d:StartDate m:type="Edm.DateTime">2014-06-08T01: 00: 00Z</d:StartDate><d:DueDate m:type="Edm.DateTime">2014-06-08T10: 00: 00Z</d:DueDate><d:BaoCaoNhiemVu>&lt;div class="ExternalClassCDA0E31679CF448D9F5D20C30E8D0D2C"&gt;Văn phòng đã nhận và đưa vào lịch tuần.&lt;/div&gt;</d:BaoCaoNhiemVu><d:DanhGiaCongViec m:type="Edm.Boolean">true</d:DanhGiaCongViec><d:DateCompleted m:type="Edm.DateTime">2014-06-08T23: 54: 38Z</d:DateCompleted><d:DepartmentManagerId m:null="true" /><d:ItemParentID m:null="true" /><d:NguoiPhoiHopId m:null="true" /><d:PriorityEN>Normal</d:PriorityEN><d:Rating m:null="true" /><d:SendMailWhenUpdate m:type="Edm.Boolean">false</d:SendMailWhenUpdate><d:StatusEN>Completed</d:StatusEN><d:TheoDoiCongViecId m:type="Collection(Edm.Int32)"><d:element>898</d:element><d:element>728</d:element></d:TheoDoiCongViecId><d:TinhTrangGiaoViec>Đồng ý</d:TinhTrangGiaoVi