plication/xml"><m:properties><d:Title>Nguyễn Thanh Quang - TB CNTT</d:Title></m:properties></content></entry><entry><id>84c3f94c-1095-4b99-94c1-57ced2f36a17</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Hà Việt Anh - CNTT</d:Title></m:properties></content></entry></feed></m:inline></link><link rel="http://schemas.microsoft.com/ado/2007/08/dataservices/related/Author" type="application/atom+xml;type=entry" title="Author" href="Web/Lists(guid'fec511d8-e617-41c0-9c63-ead5cb201f8a')/Items(1531)/Author"><m:inline><entry><id>a11e3e6a-e070-4c55-ac26-5d233f4374fd</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Hà Việt Anh - CNTT</d:Title></m:properties></content></entry></m:inline></link><link rel="http://schemas.microsoft.com/ado/2007/08/dataservices/related/Editor" type="application/atom+xml;type=entry" title="Editor" href="Web/Lists(guid'fec511d8-e617-41c0-9c63-ead5cb201f8a')/Items(1531)/Editor"><m:inline><entry><id>828b0ad5-6c8c-4654-a202-5fae89a31f2f</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Hà Việt Anh - CNTT</d:Title></m:properties></content></entry></m:inline></link><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:FileSystemObjectType m:type="Edm.Int32">0</d:FileSystemObjectType><d:Id m:type="Edm.Int32">1531</d:Id><d:ContentTypeId>0x010800D69788E4040B5E40B89CFE80B4DD7962</d:ContentTypeId><d:Title>Trang bị máy in màu cho PTGĐ Hoàng</d:Title><d:Priority>Thường</d:Priority><d:PercentComplete m:type="Edm.Double">0</d:PercentComplete><d:AssignedToId m:type="Collection(Edm.Int32)"><d:element>1046</d:element></d:AssignedToId><d:Body>&lt;div class="ExternalClass531BD1F4F6A145759ACFF8E30954ADC5"&gt;&lt;p&gt;​Theo email đ/c Thành SIC&lt;/p&gt;&lt;p&gt;Dear Mr Quân!&lt;/p&gt;&lt;p&gt;Cc &amp;#58; P.Cntt ; Mr V.Anh ; P KHKD !&lt;/p&gt;&lt;p&gt;Trong tuần qua em được PTGD Hoàng y/c kiểm tra máy in màu ptgd đang sử dụng!&lt;/p&gt;&lt;p&gt;Máy in này đã trang bị từ năm 2008 và đã sửa chữa nhiều lần liên quan đến hộp mực, cổng kết nối! qua kiểm tra máy hiên tai đã hư hỏng nặng. PTGD Hoàng yêu cầu trang bị máy in màu khác thay thế máy cũ.&lt;/p&gt;&lt;p&gt;Y/c &amp;#58; máy in màu tốc độ in nhanh, dễ sử dụng!&lt;/p&gt;&lt;p&gt;Em xin báo cáo để các anh nắm tình hình và tiến hành trang bị sớm máy in màu này!&lt;/p&gt;&lt;/div&gt;</d:Body><d:StartDate m:type="Edm.DateTime">2014-12-15T01: 00: 00Z</d:StartDate><d:DueDate m:type="Edm.DateTime">2014-12-17T10: 00: 00Z</d:DueDate><d:BaoCaoNhiemVu m:null="true" /><d:DanhGiaCongViec m:type="Edm.Boolean">true</d:DanhGiaCongViec><d:DateCompleted m:null="true" /><d:DepartmentManagerId m:null="true" /><d:ItemParentID m:null="true" /><d:NguoiPhoiHopId m:type="Collection(Edm.Int32)"><d:element>450</d:element><d:element>452</d:element><d:element>740</d:element><d:element>886</d:element><d:element>427</d:element></d:NguoiPhoiHopId><d:PriorityEN>Normal</d:PriorityEN><d:Rating m:null="true" /><d:SendMailWhenUpdate m:type="Edm.Boolean">true</d:SendMailWhenUpdate><d:StatusEN>Not Started</d:StatusEN><d:TheoDoiCongViecId m:type="Collection(Edm.Int32)"><d:element>1046</d:element><d:element>450</d:element><d:element>452</d:element><d:element>740</d:element><d:element>886</d:element><d:element>427</d:element><d:element>1367</d:element></d:TheoDoiCongViecId><d:TinhTrangGiaoViec>Đồng ý</d:TinhTrangGiaoViec><d:TinhTrangGiaoViecEN>Approved</d:TinhTrangGiaoViecEN><d: