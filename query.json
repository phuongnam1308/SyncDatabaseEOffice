s(1436)/Author"><m:inline><entry><id>31d65160-033b-4b55-b7ed-f6d76ded3bb2</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Hoàng Văn Anh - GĐTT TCIS</d:Title></m:properties></content></entry></m:inline></link><link rel="http://schemas.microsoft.com/ado/2007/08/dataservices/related/Editor" type="application/atom+xml;type=entry" title="Editor" href="Web/Lists(guid'fec511d8-e617-41c0-9c63-ead5cb201f8a')/Items(1436)/Editor"><m:inline><entry><id>40ff7641-20e1-4bf3-90d1-9a20928bff21</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Hoàng Văn Anh - GĐTT TCIS</d:Title></m:properties></content></entry></m:inline></link><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:FileSystemObjectType m:type="Edm.Int32">0</d:FileSystemObjectType><d:Id m:type="Edm.Int32">1436</d:Id><d:ContentTypeId>0x010800D69788E4040B5E40B89CFE80B4DD7962</d:ContentTypeId><d:Title>Nâng cấp thiết bị CNTT cho VP TCT</d:Title><d:Priority>Thường</d:Priority><d:PercentComplete m:type="Edm.Double">1</d:PercentComplete><d:AssignedToId m:type="Collection(Edm.Int32)"><d:element>886</d:element></d:AssignedToId><d:Body>&lt;div class="ExternalClassC4EFE40F516D4D3B9221E707E7CC2287"&gt;&lt;p&gt;Do p.CNTT không add Khánh vào ds nên anh không&amp;#160;để&amp;#160;ý vẫn gửi cho em.&lt;/p&gt;&lt;p&gt;Anh gửi lại kết quả khảo sát của&amp;#160;đ/c Thành.&lt;/p&gt;&lt;p&gt;--------------------------------------&lt;/p&gt;&lt;p&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;Căn cứ công văn&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;đề nghị của Văn phòng TCT&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;và&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;kết quả khảo sát thiết bị CNTT&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;của VP&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;do TCIS thực hiện, đề nghị TCIS&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;​tiến hành thay thế, nâng cấp&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;&amp;#160;các&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;hạng mục theo đề xuất. Các hạng mục nhỏ lẻ (1,
2,&amp;#160;5) sẽ tính vào trang bị nhỏ lẻ; các hạng mục 4,
6 sẽ đưa vào gói trang bị CNTT T5/2014.&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</d:Body><d:StartDate m:type="Edm.DateTime">2014-05-16T01: 00: 00Z</d:StartDate><d:DueDate m:type="Edm.DateTime">2014-06-30T10: 00: 00Z</d:DueDate><d:BaoCaoNhiemVu m:null="true" /><d:DanhGiaCongViec m:type="Edm.Boolean">true</d:DanhGiaCongViec><d:DateCompleted m:type="Edm.DateTime">2014-09-18T06: 33: 48Z</d:DateCompleted><d:DepartmentManagerId m:null="true" /><d:ItemParentID>1395</d:ItemParentID><d:NguoiPhoiHopId m:type="Collection(Edm.Int32)"><d:element>1301</d:element></d:NguoiPhoiHopId><d:PriorityEN>Normal</d:PriorityEN><d:Rating>5</d:Rating><d:SendMailWhenUpdate m:type="Edm.Boolean">true</d:SendMailWhenUpdate><d:StatusEN>Completed</d:StatusEN><d:TheoDoiCongViecId m:type="Collection(Edm.Int32)"><d:element>804</d:element><d:element>450</d:element><d:element>740</d:element><d:element>965</d:element><d:element>440</d:element><d:element>427</d:element><d:element>886</d:element><d:element>1301</d:element></d:TheoDoiCongViecId><d:TinhTrangGiaoViec>Đồng ý</d:TinhTrangGiaoViec><d:TinhTrangGiaoViecEN>Approved</d:TinhTrangGiaoViecEN><d:XacNhan m:type="Edm.Boolean">false</d:XacNhan><d:NguoiTheoDoiId m:type="Edm.Int32">804</d:NguoiTheoDoiId><d:ManagerId m:null="true" /><d:nStatus>Hoàn thành</d:nStatus><d:ID m:type="Edm.Int32">1436</d:ID><d:MultiTask m:type="Edm.Boolean">false</d:MultiTask><d:TT m:null="true" /><d:ThucHienLai m:type="Edm.Double">0</d:ThucHienLai><d:IDVB m:null="true" /><d:ListVB m:null="true" /><d:WebVB m:null="true" /><d:NhomCongViecId m:type="Edm.Int32">8</d:NhomCongViecId><d:ChatLuong>5</d:ChatLuong><d:DiemTrungBinh m:type="Edm.Double">5</d:DiemTrungBinh><d:AuthorId m:type="Edm.Int32">804</d:AuthorId><d:RecurTaskParentID m:null="true" /><d:IsRecurrence m:type="Edm.Boolean">false</d:IsRecurrence><d:Recurrence m:null="true" /><d:OpenDate m:type="Edm.DateTime">2014-06-25T01: 58: 21Z</d:OpenDate><d:Created m:type="Edm.DateTime">2014-06-23T10: 23: 15Z</d:Created><d:Modified m:type="Edm.Da