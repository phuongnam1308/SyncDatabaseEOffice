/id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Châu Hải Thương - CT HĐQT TCIS</d:Title></m:properties></content></entry><entry><id>b042c043-3bc5-404f-a8bb-1eec772ff511</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Lê Thành Tâm - TCIS</d:Title></m:properties></content></entry><entry><id>83a93cba-ec91-4308-9146-5f2e5b7f58b0</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Nguyễn Thanh Quang - TB CNTT</d:Title></m:properties></content></entry><entry><id>2e609024-fc1b-4d28-8438-109f9e5a3f84</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Ngô Minh Thuấn - Tư lệnh Binh đoàn, Chủ tịch, TGĐ</d:Title></m:properties></content></entry><entry><id>4a38b50c-6c5f-41a3-bd79-16430b9957dd</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Nguyễn Văn Phương - CN CTr</d:Title></m:properties></content></entry></feed></m:inline></link><link rel="http://schemas.microsoft.com/ado/2007/08/dataservices/related/Author" type="application/atom+xml;type=entry" title="Author" href="Web/Lists(guid'fec511d8-e617-41c0-9c63-ead5cb201f8a')/Items(1449)/Author"><m:inline><entry><id>e83fffd3-d971-4713-ac5d-6b89e84eb228</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Nguyễn Thanh Quang - TB CNTT</d:Title></m:properties></content></entry></m:inline></link><link rel="http://schemas.microsoft.com/ado/2007/08/dataservices/related/Editor" type="application/atom+xml;type=entry" title="Editor" href="Web/Lists(guid'fec511d8-e617-41c0-9c63-ead5cb201f8a')/Items(1449)/Editor"><m:inline><entry><id>6fffafee-b330-4b84-9bd1-9d04ca58a2d0</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Nguyễn Thanh Quang - TB CNTT</d:Title></m:properties></content></entry></m:inline></link><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:FileSystemObjectType m:type="Edm.Int32">0</d:FileSystemObjectType><d:Id m:type="Edm.Int32">1449</d:Id><d:ContentTypeId>0x010800D69788E4040B5E40B89CFE80B4DD7962</d:ContentTypeId><d:Title>Thực hiện kết luận của PTGĐ Thuấn về triển khai phần mềm VPĐT</d:Title><d:Priority>Thường</d:Priority><d:PercentComplete m:type="Edm.Double">1</d:PercentComplete><d:AssignedToId m:type="Collection(Edm.Int32)"><d:element>965</d:element><d:element>1369</d:element></d:AssignedToId><d:Body>&lt;div class="ExternalClass0D4292029CD14AFA8E4A7D9AC08EC248"&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;&lt;/span&gt;&lt;div&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;C&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;ăn cứ nội du&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;ng kết luận của cuộc&amp;#160;họp tổng kết đánh giá kết quả triển khai golive Văn phòng điện tử (từ ngày 1/3/2014 đến nay)&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;do&amp;#160;PTGĐ Thuấn&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;&amp;#160;chủ trì, đề nghị CNTT triển&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;khai&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;một số công tác sau (trích lại 2/9 điểm liên quan)&amp;#58;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Giao Phòng Công nghệ thông tin, TCIS nghiên cứu, tìm giải pháp khắc phục tình trạng sóng Wifi yếu tại khu vực văn phòng TCT như hiện nay và phối hợp với Vũ Thảo có giải pháp để sử dụng E-office ổn định trên các loại thiết bị khác nhau hiện nay ---&amp;gt;&amp;#160;chuyển Mai Thành Long chủ trì, phối hợp cùng TCIS đánh giá tình trạng wifi tại khu vực VP TCT để lên giải pháp xử lý triệt để.&lt;/li&gt;&lt;li&gt;Ban QLDA phối hợp với Vũ Thảo tích hợp phần mềm quản lý thư viện, quản lý hàng nguy hiểm (IMDG) của Tổng công ty trên hệ thống, phục vụ cho việc tra cứu nhanh chóng, chính xác&amp;#160;---&amp;gt;&amp;#160;chuyển Phạm Xuân Tùng chủ trì, phối hợp cùng TCIS (nếu cần) đề xuất giải pháp tích hợp (cấp độ web service hoặc database).&lt;/li&gt;&lt;/ul&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;</d:Body><d:StartDate m:type="Edm.DateTime">2014-07-09T01: 00: 00Z</d:StartDate><d:DueDate m:type="Edm.DateTime">2014-08-15T10: 00: 00Z</d:DueDate><d:BaoCaoNhiemVu m:null="true" /><d:DanhGiaCongViec m:type="Edm.Boolean">true</d:DanhGiaCongViec><d:DateCompleted m:type="Edm.DateTime">2014-12-10T01: 30: 03Z</d:DateCompleted><d:DepartmentManagerId m:null="true" /><d:ItemP