><author><name /></author><content type="application/xml"><m:properties><d:Title>Bùi Hải Quân - CT HĐQT DVKT</d:Title></m:properties></content></entry><entry><id>135edfa0-7d0a-4c32-8770-510d14e9caff</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Nguyễn Sơn Hải - GĐ TCIS</d:Title></m:properties></content></entry><entry><id>84c226a8-ed1e-4225-8451-9ec73adfc504</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Châu Hải Thương - CT HĐQT TCIS</d:Title></m:properties></content></entry></feed></m:inline></link><link rel="http://schemas.microsoft.com/ado/2007/08/dataservices/related/Author" type="application/atom+xml;type=entry" title="Author" href="Web/Lists(guid'fec511d8-e617-41c0-9c63-ead5cb201f8a')/Items(1448)/Author"><m:inline><entry><id>69c63db0-e3ef-4dc9-a066-5a50bfd22804</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Nguyễn Thanh Quang - TB CNTT</d:Title></m:properties></content></entry></m:inline></link><link rel="http://schemas.microsoft.com/ado/2007/08/dataservices/related/Editor" type="application/atom+xml;type=entry" title="Editor" href="Web/Lists(guid'fec511d8-e617-41c0-9c63-ead5cb201f8a')/Items(1448)/Editor"><m:inline><entry><id>369a0eea-dc47-410d-8adf-3195a1026c91</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Nguyễn Thanh Quang - TB CNTT</d:Title></m:properties></content></entry></m:inline></link><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:FileSystemObjectType m:type="Edm.Int32">0</d:FileSystemObjectType><d:Id m:type="Edm.Int32">1448</d:Id><d:ContentTypeId>0x010800D69788E4040B5E40B89CFE80B4DD7962</d:ContentTypeId><d:Title>Thực hiện kết luận của PTGĐ Thuấn về triển khai phần mềm VPĐT</d:Title><d:Priority>Thường</d:Priority><d:PercentComplete m:type="Edm.Double">1</d:PercentComplete><d:AssignedToId m:type="Collection(Edm.Int32)"><d:element>427</d:element></d:AssignedToId><d:Body>&lt;div class="ExternalClass0D4292029CD14AFA8E4A7D9AC08EC248"&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;&lt;/span&gt;&lt;div&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;C&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;ăn cứ nội du&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;ng kết luận của cuộc&amp;#160;họp tổng kết đánh giá kết quả triển khai golive Văn phòng điện tử (từ ngày 1/3/2014 đến nay)&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;do&amp;#160;PTGĐ Thuấn&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;&amp;#160;chủ trì, đề nghị CNTT triển&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;khai&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;một số công tác sau&amp;#58;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Giao Văn phòng, Phòng CNTT tiếp tục rà soát, điều chỉnh các phân hệ chức năng cho phù hợp tính năng sử dụng của người dùng và các đơn vị trong Tổng công ty theo như báo cáo.&lt;/li&gt;&lt;li&gt;Giao Phòng Công nghệ thông tin, TCIS nghiên cứu, tìm giải pháp khắc phục tình trạng sóng Wifi yếu tại khu vực văn phòng TCT như hiện nay và phối hợp với Vũ Thảo có giải pháp để sử dụng E-office ổn định trên các loại thiết bị khác nhau hiện nay.&lt;/li&gt;&lt;li&gt;Ban QLDA phối hợp với Vũ Thảo tích hợp phần mềm quản lý thư viện, quản lý hàng nguy hiểm (IMDG) của Tổng công ty trên hệ thống, phục vụ cho việc tra cứu nhanh chóng, chính xác.&lt;/li&gt;&lt;li&gt;Văn phòng tiếp tục chủ trì công tác tổ chức các văn bản lưu trữ hợp lý, phục vụ việc tra cứu văn bản.&lt;/li&gt;&lt;li&gt;Phòng CNTT chủ trì, Văn phòng phối hợp trong việc tăng cường an toàn bảo mật thông tin trên VPĐT theo quy định. Phòng Chính trị tăng cường hơn nữa công tác đưa tin bài lên phân hệ tin tức, diễn đàn trong thời gian tới.&lt;/li&gt;&lt;li&gt;Văn phòng chủ trì theo dõi, báo cáo đánh giá việc sử dụng VPĐT của các cá nhân, đơn vị và có các biện pháp để tăng cường việc sử dụng VPĐT, nhất là các phân hệ chức năng còn ít sử dụng để tiến tới xóa bỏ việc dùng văn bản giấy, giao việc và đánh giá kết quả công việc trên VPĐT. Yêu cầu chỉ huy các đơn vị trong Tổng công ty thường xuyên cập nhật văn bản, tin tức trên VPĐT liên quan đến hoạt động của Tổng công ty và đơn vị để triển khai, điều hành công việc của đơn vị mình được kịp thời, thông suốt.&lt;/li&gt;&lt;li&gt;Ban QLDA và Tổ dự án xem xét thanh lý hợp đồng đã ký với Vũ Thảo.&lt;/li&gt;&lt;li&gt;Văn phòng, Phòng CNTT phối hợp với các Công ty thành viên trong Tổng công ty xúc tiến việc đàm phán với Vũ Thảo để triển khai các site riêng cho các Công ty thành viên.&lt;/li&gt;&lt;/ul&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;</d:Body><d:StartDate m:type="Edm.DateTime">2014-07-09T01: 00: 00Z</d:StartDate><d:DueDate m:type="Edm.DateTime">2014-08-15T10: 00: 00Z</d:DueDate><d:BaoCaoNhiemVu m:null="true" /><d:DanhGiaCongViec m:type="Edm.Boolean">true</d:DanhGiaCongViec><d:DateCompleted m:type="Edm.DateT