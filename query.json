công ty.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;- Xin phép em gửi lại nội dung phân công qua đường giao việc để các anh nắm và chỉ đạo.&lt;/p&gt;&lt;p&gt;- Em chuyển PTGĐ Chiến giao việc và nắm, chỉ đạo.&lt;/p&gt;&lt;p&gt; (Em Phương, CVP).&lt;br&gt;&lt;/p&gt;&lt;/div&gt;</d:Body><d:StartDate m:type="Edm.DateTime">2014-04-07T01: 00: 00Z</d:StartDate><d:DueDate m:type="Edm.DateTime">2014-04-07T10: 00: 00Z</d:DueDate><d:BaoCaoNhiemVu>&lt;div class="ExternalClass039D7A71707B49B4AC6D59E23A857102"&gt;Đang triển khai thực hiện&lt;/div&gt;</d:BaoCaoNhiemVu><d:DanhGiaCongViec m:type="Edm.Boolean">true</d:DanhGiaCongViec><d:DateCompleted m:type="Edm.DateTime">2014-04-07T07: 34: 21Z</d:DateCompleted><d:DepartmentManagerId m:null="true" /><d:ItemParentID m:null="true" /><d:NguoiPhoiHopId m:null="true" /><d:PriorityEN>Normal</d:PriorityEN><d:Rating>5</d:Rating><d:SendMailWhenUpdate m:type="Edm.Boolean">false</d:SendMailWhenUpdate><d:StatusEN>Completed</d:StatusEN><d:TheoDoiCongViecId m:type="Collection(Edm.Int32)"><d:element>457</d:element><d:element>474</d:element><d:element>473</d:element><d:element>747</d:element><d:element>748</d:element><d:element>737</d:element><d:element>738</d:element><d:element>633</d:element><d:element>755</d:element><d:element>429</d:element><d:element>732</d:element></d:TheoDoiCongViecId><d:TinhTrangGiaoViec>Đồng ý</d:TinhTrangGiaoViec><d:TinhTrangGiaoViecEN>Approved</d:TinhTrangGiaoViecEN><d:XacNhan m:type="Edm.Boolean">false</d:XacNhan><d:NguoiTheoDoiId m:type="Edm.Int32">732</d:NguoiTheoDoiId><d:ManagerId m:null="true" /><d:nStatus>Hoàn thành</d:nStatus><d:ID m:type="Edm.Int32">1274</d:ID><d:MultiTask m:type="Edm.Boolean">false</d:MultiTask><d:TT m:null="true" /><d:ThucHienLai m:type="Edm.Double">0</d:ThucHienLai><d:IDVB m:null="true" /><d:ListVB m:null="true" /><d:WebVB m:null="true" /><d:NhomCongViecId m:type="Edm.Int32">13</d:NhomCongViecId><d:ChatLuong>5</d:ChatLuong><d:DiemTrungBinh m:type="Edm.Double">5</d:DiemTrungBinh><d:AuthorId m:type="Edm.Int3