/d:PercentComplete><d:AssignedToId m:type="Collection(Edm.Int32)"><d:element>705</d:element></d:AssignedToId><d:Body>&lt;div class="ExternalClass710BF270398A49B0A3CE5B82591ADAAC"&gt;&lt;div style="color&amp;#58;#000000;font-family&amp;#58;tahoma;font-size&amp;#58;13.33px;font-style&amp;#58;normal;font-weight&amp;#58;400;"&gt;
					Gửi đ/c Nam,&lt;/div&gt;&lt;div style="color&amp;#58;#000000;font-family&amp;#58;tahoma;font-size&amp;#58;13.33px;font-style&amp;#58;normal;font-weight&amp;#58;400;"&gt;
					&amp;#160;&lt;/div&gt;&lt;div style="color&amp;#58;#000000;font-family&amp;#58;tahoma;font-size&amp;#58;13.33px;font-style&amp;#58;normal;font-weight&amp;#58;400;"&gt;
					Mình đang cung cấp một số giấy tờ để tham gia dự
án Long Sơn. Vì Vậy, đ/c có thể cho mình
xin &amp;#58;&lt;/div&gt;&lt;div style="color&amp;#58;#000000;font-family&amp;#58;tahoma;font-size&amp;#58;13.33px;font-style&amp;#58;normal;font-weight&amp;#58;400;"&gt;
					&amp;#160;&lt;/div&gt;&lt;div style="color&amp;#58;#000000;font-family&amp;#58;tahoma;font-size&amp;#58;13.33px;font-style&amp;#58;normal;font-weight&amp;#58;400;"&gt;
					Giấy chứng nhận đảm bảo an toàn phòng chống
cháy nổ đối với Cảng khi Cát Lái và
TCCT chính thức đi vào hoạt động (giấy được
cấp trong thời gian gần nhất)&lt;/div&gt;&lt;div style="color&amp;#58;#000000;font-family&amp;#58;tahoma;font-size&amp;#58;13.33px;font-style&amp;#58;normal;font-weight&amp;#58;400;"&gt;
					&amp;#160;&lt;/div&gt;&lt;div style="color&amp;#58;#000000;font-family&amp;#58;tahoma;font-size&amp;#58;13.33px;font-style&amp;#58;normal;font-weight&amp;#58;400;"&gt;
					Nếu có thì scan giúp mình nhé.
Cảm ơn đ/c&lt;/div&gt;&lt;/div&gt;</d:Body><d:StartDate m:type="Edm.DateTime">2014-03-19T01: 00: 00Z</d:StartDate><d:DueDate m:type="Edm.DateTime">2014-03-19T10: 00: 00Z</d:DueDate><d:BaoCaoNhiemVu m:null="true" /><d:DanhGiaCongViec m:type="Edm.Boolean">true</d:DanhGiaCongViec><d:DateCompleted m:null="true" /><d:DepartmentManagerId m:null="true" /><d:ItemParentID m:null="true" /><d:NguoiPhoiHopId m:null="true" /><d:PriorityEN>Normal</d:PriorityEN><d:Rating m:null="true" /><d:SendMailWhenUpdate m:type="Edm.Boolean">false</d:SendMailWhenUpdate><d:StatusEN>In Progress</d:StatusEN><d:TheoDoiCongViecId m:type="Collection(Edm.Int32)"><d:element>705</d:element><d:element>799</d:element></d:TheoDoiCongViecId><d:TinhTrangGiaoViec>Đồng ý</d:TinhTrangGiaoViec><d:TinhTrangGiaoViecEN>Approved</d:TinhTrangGiaoViecEN><d:XacNhan m:type="Edm.Boolean">false</d:XacNhan><d:NguoiTheoDoiId m:type="Edm.Int32">799</d:NguoiTheoDoiId><d:ManagerId m:null="true" /><d:nStatus>Đang thực hiện</d:nStatus><d:ID m:type="Edm.Int32">1232</d:ID><d:MultiTask m:type="Edm.Boolean">false</d:MultiTask><d:TT m:null="true" /><d:ThucHienLai m:type="Edm.Double">1</d:ThucHienLai><d:IDVB m:null="true" /><d:ListVB m:null="true" /><d:WebVB m:null="true" /><d:NhomCongViecId m:type="Edm.Int32">13</d:NhomCongViecId><d:ChatLuong m:null="true" /><d:DiemTrungBinh m:null="true" /><d:AuthorId m:type="Edm.Int32">799</d:AuthorId><d:RecurTaskParentID m:null="true" /><d:IsRecurrence m:type="Edm.Boolean">false</d:IsRecurrence><d:Recurrence m:null="true" /><d:OpenDate m:type="Edm.DateTime">2014-03-21T01: 45: 59Z</d:OpenDate><d:Created m:type="Edm.DateTime">2014-03-19T01: 42: 57Z</d:Created><d:Modified m:type="Edm.DateTime">2014-05-16T06: 29: 55Z</d:Modified><d:EditorId m:type="Edm.Int32">799</d:EditorId><d:OData__UIVersionString>4.0</d:OData__UIVersionString><d:Attachments m:type="Edm.Boolean">false</d:Attachments><d:GUID m:type="Edm.Guid">fe845273-0d80-41ce-8c43-b056de373942</d:GUID></m:properties></content></entry><entry m:eta