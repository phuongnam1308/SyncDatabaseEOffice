microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Hoàng Văn Anh - GĐTT TCIS</d:Title></m:properties></content></entry></m:inline></link><link rel="http://schemas.microsoft.com/ado/2007/08/dataservices/related/Editor" type="application/atom+xml;type=entry" title="Editor" href="Web/Lists(guid'fec511d8-e617-41c0-9c63-ead5cb201f8a')/Items(1394)/Editor"><m:inline><entry><id>7b2222fe-f023-4b8f-9dc7-3aaba4344409</id><category term="SP.Data.UserInfoItem" scheme="http://schemas.microsoft.com/ado/2007/08/dataservices/scheme" /><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:Title>Hoàng Văn Anh - GĐTT TCIS</d:Title></m:properties></content></entry></m:inline></link><title /><updated>2026-05-19T03: 36: 31Z</updated><author><name /></author><content type="application/xml"><m:properties><d:FileSystemObjectType m:type="Edm.Int32">0</d:FileSystemObjectType><d:Id m:type="Edm.Int32">1394</d:Id><d:ContentTypeId>0x010800D69788E4040B5E40B89CFE80B4DD7962</d:ContentTypeId><d:Title>Khảo sát máy in Ban Doanh trại/QLCT</d:Title><d:Priority>Thường</d:Priority><d:PercentComplete m:type="Edm.Double">1</d:PercentComplete><d:AssignedToId m:type="Collection(Edm.Int32)"><d:element>965</d:element></d:AssignedToId><d:Body>&lt;div class="ExternalClassBB7FC9F5262A4E5495774F04BE60AF68"&gt;&lt;p&gt;Mt.Long&amp;#58; em phân công nhân sự thực hiện khảo sát này.​&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;​&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;------&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;Căn cứ&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;công văn đề nghị&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;ngày&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;​12/5/2014 của P. QLCT&amp;#160;(đính kèm), đề nghị TCIS tiến hành khảo sát máy in cho Ban Doanh trại. Kết quả khảo sát báo&amp;#160;về P. CNTT trước ngày 17/5/2014.&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</d:Body><d:StartDate m:type="Edm.DateTime">2014-05-14T01: 00: 00Z</d:StartDate><d:DueDate m:type="Edm.DateTime">2014-05-16T10: 00: 00Z</d:DueDate><d:BaoCaoNhiemVu m:null="true" /><d:DanhGiaCongViec m:type="Edm.Boolean">true</d:DanhGiaCongViec><d:DateCompleted m:type="Edm.DateTime">2014-05-21T06: 49: 03Z</d:DateCompleted><d:DepartmentManagerId m:null="true" /><d:ItemParentID>1389</d:ItemParentID><d:NguoiPhoiHopId m:type="Collection(Edm.Int32)"><d:element>1301</d:element></d:NguoiPhoiHopId><d:PriorityEN>Normal</d:PriorityEN><d:Rating>5</d:Rating><d:SendMailWhenUpdate m:type="Edm.Boolean">true</d:SendMailWhenUpdate><d:StatusEN>Completed</d:StatusEN><d:TheoDoiCongViecId m:type="Collection(Edm.Int32)"><d:element>804</d:element><d:element>450</d:element><d:element>740</d:element><d:element>626</d:element><d:element>427</d:element><d:element>965</d:element><d:element>1301</d:element></d:TheoDoiCongViecId><d:TinhTrangGiaoViec>Đồng ý</d:TinhTrangGiaoViec><d:TinhTrangGiaoViecEN>Approved</d:TinhTrangGiaoViecEN><d:XacNhan m:type="Edm.Boolean">false</d:XacNhan><d:NguoiTheoDoiId m:type="Edm.Int32">804</d:NguoiTheoDoiId><d:ManagerId m:null="true" /><d:nStatus>Hoàn thành</d:nStatus><d:ID m:type="Edm.Int32">1394</d:ID><d:MultiTask m:type="Edm.Boolean">false</d:MultiTask><d:TT m:null="true" /><d:ThucHienLai m:type="Edm.Double">0</d:ThucHienLai><d:IDVB m:null="true" /><d:ListVB m:null="true" /><d:WebVB m:null="true" /><d:NhomCongViecId m:type="Edm.Int32">8</d:NhomCongViecId><d:ChatLuong>5</d:ChatLuong><d:DiemTrungBinh m:type="E