pe="application/xml"><m:properties><d:FileSystemObjectType m:type="Edm.Int32">0</d:FileSystemObjectType><d:Id m:type="Edm.Int32">1388</d:Id><d:ContentTypeId>0x010800D69788E4040B5E40B89CFE80B4DD7962</d:ContentTypeId><d:Title>Khảo sát máy in Đội Cơ giới 4/XNCG</d:Title><d:Priority>Thường</d:Priority><d:PercentComplete m:type="Edm.Double">1</d:PercentComplete><d:AssignedToId m:type="Collection(Edm.Int32)"><d:element>804</d:element></d:AssignedToId><d:Body>&lt;div class="ExternalClass1EFC1605E77F438BABFD3B5316F71471"&gt;&lt;p&gt;​&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;Căn cứ&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;công văn đề nghị&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;ngày&amp;#160;&lt;/span&gt;&lt;span style="line-height&amp;#58;19.200000762939453px;"&gt;​12/5/2014 của XNCG (đính kèm), đề nghị TCIS tiến hành khảo sát máy in VP Đội CG4. Trong trường hợp máy không in được thì trang bị tạm thời 1 máy in cũ (trong số các máy vừa sửa đợt trước), đồng thời báo cáo kết quả khảo sát về P. CNTT.&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</d:Body><d:StartDate m:type="Edm.DateTime">2014-05-14T01: 00: 00Z</d:StartDate><d:DueDate m:type="Edm.DateTime">2014-05-16T10: 00: 00Z</d:DueDate><d:BaoCaoNhiemVu>&lt;div class="ExternalClass81435F860F8D4DC3A2F74BDF376194E9"&gt;Đề nghị TCIS gửi báo cáo chi tiết (thông số máy, năm trang bị, tình trạng...)&lt;/div&gt;</d:BaoCaoNhiemVu><d:DanhGiaCongViec m:type="Edm.Boolean">true</d:DanhGiaCongViec><d:DateCompleted m:type="Edm.DateTime">2014-05-20T06: 36: 37Z</d:DateCompleted><d:DepartmentManagerId m:null="true" /><d:ItemParentID m:null="true" /><d:NguoiPhoiHopId m:type="Collection(Edm.Int32)"><d:element>450</d:element><d:element>740</d:element><d:element>454</d:element><d:element>455</d:element><d:element>591</d:element></d:NguoiPhoiHopId><d:PriorityEN>Normal</d:PriorityEN><d:Rating>5</d:Rating><d:SendMailWhenUpdate m:type="Edm.Boolean">true</