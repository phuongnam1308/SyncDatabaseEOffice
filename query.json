58;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Máy đang sử dụng win 8 ; em đã liên hệ Mr Dương và được thêm yêu cầu cài đặt về Win 7&lt;/li&gt;&lt;li&gt;ổ cứng máy laptop này hiện sắp hư hỏng, lúc khởi động máy lên có hiển thị cảnh báo&lt;/li&gt;&lt;li&gt;Yêu cầu thay ổ cứng HDD&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;</d:Body><d:StartDate m:type="Edm.DateTime">2014-09-05T01: 00: 00Z</d:StartDate><d:DueDate m:type="Edm.DateTime">2014-09-10T10: 00: 00Z</d:DueDate><d:BaoCaoNhiemVu m:null="true" /><d:DanhGiaCongViec m:type="Edm.Boolean">true</d:DanhGiaCongViec><d:DateCompleted m:type="Edm.DateTime">2014-09-30T01: 45: 14Z</d:DateCompleted><d:DepartmentManagerId m:null="true" /><d:ItemParentID m:null="true" /><d:NguoiPhoiHopId m:type="Collection(Edm.Int32)"><d:element>740</d:element><d:element>804</d:element><d:element>450</d:element><d:element>427</d:element><d:element>452</d:element><d:element>886</d:element><d:element>970</d:element></d:NguoiPhoiHopId><d:PriorityEN>Normal</d:PriorityEN><d:Rating m:null="true" /><d:SendMailWhenUpdate m:type="Edm.Boolean">true</d:SendMailWhenUpdate><d:StatusEN>Completed</d:StatusEN><d:TheoDoiCongViecId m:type="Collection(Edm.Int32)"><d:element>1301</d:element><d:element>1046</d:element><d:element>740</d:element><d:element>804</d:element><d:element>450</d:element><d:element>427</d:element><d:element>452</d:element><d:element>886</d:element><d:element>970</d:element><d:element>1367</d:element></d:TheoDoiCongViecId><d:TinhTrangGiaoViec>Đồng ý</d:TinhTrangGiaoViec><d:TinhTrangGiaoViecEN>Approved</d:TinhTrangGiaoViecEN><d:XacNhan m:type="Edm.Boolean">false</d:XacNhan><d:NguoiTheoDoiId m:type="Edm.Int32">1367</d:NguoiTheoDoiId><d:ManagerId m:null="true" /><d:nStatus>Hoàn thành</d:nStatus><d:ID m:type="Edm.Int32">1474</d:ID><d:MultiTask m:type="Edm.Boolean">false</d:MultiTask><d:TT m:null="true" /><d:ThucHienLai m:type="Edm.Double">0</d:ThucHienLai><d:IDVB m:null="true" /><d:ListVB m:null="true" /><d:WebVB m:null="true" /><d:NhomCongViecId m:type="Edm.Int32">13</d