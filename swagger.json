        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reset": {
                    "type": "boolean",
                    "description": "Nếu là true, sẽ xóa trạng thái cũ và chạy lại từ đầu."
                  }
                }
              }
            }
          }
        },
